        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
    {
      "label": "Run tests|Clear test failures from panel",
      "detail": "Remove test failure entries from the Problems panel",
      "icon": {
        "id": "clear-all"
      },
      "type": "shell",
      "command": "true",
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Test Failes",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "",
          "message": 0,
          "file": 0
        }
      },
      "presentation": {
        "clear": true,
        "close": true,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Tests"
      }
    }
  ]
}