        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
    { // ------------
      "label": "Run tests|TreeModel|Hierarchy",
      "detail": "Run the Hierarchy unit tests",
      "icon": {
        "id": "beaker"
      },
      "dependsOn": [
        "Pretest"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/run-unit-test.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TEST_CONFIG_FILE": ".vscode-test/vscode-unit-test.mjs",
          "TEST_REPORTER": "spec",
          "UNIT_TESTS": "TreeModel.Hierarchy::*"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Test Failes",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
