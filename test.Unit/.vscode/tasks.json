// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open as project",
      "hide":  true,
      "icon": {
        "id": "vscode",
        "color": "terminal.ansiBlue"
      },
      "detail": "Open current workspace in a new Codium window",
      "type": "shell",
      "command": "setsid -f codium '${workspaceFolder}' && sleep 3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "close": true,
        "group": "run-external"
      }
    },
    // -----
    {
      "label": "Prepare TEST environment",
      "detail": "Set up environment variables and directories for test runs",
      "icon": {
        "id": "symbol-event"
      },
      "dependsOn": [
        "Clear"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/prepare-test-env.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_BASE": "../Task Cockpit/src"
        }
      },
      "presentation": {}
    },
    // -----
    {
      "label": "Clear",
      "detail": "Clear and recreate all output, test, and stripped directories",
      "icon": {
        "id": "eraser"
      },
      "dependsOn": [
        "Clear|Clean/create '~out-test/'",
        "Clear|Clean/create '~stripped/'"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "Clear"
      }
    },
    {
      "label": "Clear|Clean/create '~out-test/'",
      "detail": "Ensure '~out-test' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out-test"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem"
      }
    },
    {
      "label": "Clear|Clean/create '~stripped/'",
      "detail": "Ensure '~stripped' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~stripped"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem"
      }
    },
    //------------------
    {
      "label": "Pretest",
      "detail": "Run all pretest steps: clear, compile test sources, strip debug blocks, build stripped extension, copy necessary files",
      "icon": {
        "id": "flame"
      },
      "dependsOn": [
        // src/ стрипается
        "Pretest|Clean/create '~stripped/'",
        "Pretest|Clean/create '~out-test/'",
        "Pretest|Strip DEBUG blocks",
        "Pretest|Compile test TypeScript files into '~out-test/'",
        "Pretest|Copy required stubs for the test runner"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Clean/create '~stripped/'",
      "detail": "Ensure '~stripped' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "dependsOn": "Clear|Clean/create '~stripped/'",
      "dependsOrder": "sequence"
    },
    {
      "label": "Pretest|Clean/create '~out-test/'",
      "detail": "Ensure '~out-test' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "dependsOn": "Clear|Clean/create '~out-test/'",
      "dependsOrder": "sequence"
    },
    {
      "label": "Pretest|Strip DEBUG blocks",
      "icon": {
        "id": "regex"
      },
      "detail": "Remove debug-only code blocks from sources `src/` into `~stripped/`  \n`rc/Logger.ts` copy skipp",
      "type": "shell",
      "command": "dev-scripts/strip-debug-blocks.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_DIR": "src",
          "DEST_DIR": "~stripped/",
          "FIND_FILTERS": "-name '~*' -prune -o -wholename 'src/*.ts' ! -wholename 'src/Logger.ts'",
          "STRIP_MODE": "test"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Compile test TypeScript files into '~out-test/'",
      "detail": "Compile test TypeScript sources into the '~out-test' directory",
      "icon": {
        "id": "debug"
      },
      "dependsOn": [],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/transpile-typescript.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "WORK_DIR": "${workspaceFolder}",
          "TSCONFIG": "test.tsconfig.json"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "base": "$tsc"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Copy required stubs for the test runner",
      "detail": "Copy  \n- `package.json`  \n- `extension.js`  \nto the test output directory for the test runner",
      "icon": {
        "id": "copy"
      },
      "type": "shell",
      "command": "dev-scripts/copy-files.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_DIR": "${workspaceFolder}",
          "INCLUDES": "package.json extension.js",
          "DEST_DIR": "~out-test/"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    { // ------------
      "label": "Run tests|ALL TESTS",
      "detail": "Run the ALL TESTS unit tests",
      "icon": {
        "id": "run-all"
      },
      "dependsOn": [
        "Pretest"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/run-unit-test.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TEST_CONFIG_FILE": ".vscode-test/vscode-unit-test.mjs",
          "TEST_REPORTER": "spec",
          "UNIT_TESTS": "*::*"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Test Failes",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\s*at [^\\s]+ \\((.+):(\\d+):(\\d+)\\)",
          "message": 0,
          "file": 1,
          "line": 2,
          "column": 3
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
    { // ------------
      "label": "Run tests|utils|RevocablePromise",
      "detail": "Run the RevocablePromise unit tests",
      "icon": {
        "id": "beaker"
      },
      "dependsOn": [
        "Pretest"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/run-unit-test.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TEST_CONFIG_FILE": ".vscode-test/vscode-unit-test.mjs",
          "TEST_REPORTER": "spec",
          "UNIT_TESTS": "utils.RevocablePromise::*"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Test Failes",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\s*at [^\\s]+ \\((.+):(\\d+):(\\d+)\\)",
          "message": 0,
          "file": 1,
          "line": 2,
          "column": 3
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
    { // ------------
      "label": "Run tests|utils|AsyncQueue",
      "detail": "Run the AsyncQueue unit tests",
      "icon": {
        "id": "beaker"
      },
      "dependsOn": [
