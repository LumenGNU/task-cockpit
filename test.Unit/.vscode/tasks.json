        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
    {
      "label": "Run tests|TreeModel|Splitter",
      "detail": "Run the Splitter unit tests",
      "icon": {
        "id": "beaker"
      },
      "dependsOn": [
        "Pretest"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/run-unit-test.bash",
      "options": {
