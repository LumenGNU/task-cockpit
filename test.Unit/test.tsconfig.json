{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "sourceMap": true,
        "removeComments": false,
        "outDir": "~out-test",
        "paths": {
            "src/*": ["./~stripped/*"]
        }
    },
    "exclude": [
        "**/~*"
    ],
    "include": [
        "test/*.ts",
        "test/**/*.ts",
        "~stripped/*.ts",
        "~stripped/**/*.ts"
    ]
}