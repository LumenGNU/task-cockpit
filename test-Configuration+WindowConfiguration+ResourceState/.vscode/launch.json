// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Test Extension [semi-manual-single-folder]",
            "type": "extensionHost",
            "outFiles": [
                "${workspaceFolder}/~out/**/*.js"
            ],
            "preLaunchTask": "Build DEBUG extension",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/~out",
                // "--disable-extensions",
                "--profile", "Task Cockpit Test",
                "--locale", "en-US",
                "--log", "papio-dev.task-cockpit:trace",
                "${workspaceFolder}/test-semi-manual-single-folder/",
                "${workspaceFolder}/test-semi-manual-single-folder/README.md",
                "${workspaceFolder}/test-semi-manual-single-folder/.vscode/settings.json",
                "${workspaceFolder}/test-semi-manual-single-folder/.vscode/tasks.json"
            ],
            "env": {}
        },
        {
            "name": "Run Test Extension [semi-manual-multi-root]",
            "type": "extensionHost",
            "outFiles": [
                "${workspaceFolder}/~out/**/*.js"
            ],
            "preLaunchTask": "Build DEBUG extension",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/~out",
                // "--disable-extensions",
                "--profile", "Task Cockpit Test",
                "--locale", "en-US",
                "--log", "papio-dev.task-cockpit:trace",
                "${workspaceFolder}/test-semi-manual-multi-root/test-semi-manual-multi-root.code-workspace",
                "${workspaceFolder}/test-semi-manual-multi-root/README.md",
            ],
            "env": {}
        }
    ]
}
