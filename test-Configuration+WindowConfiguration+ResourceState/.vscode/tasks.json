      }
    },
    {
      "label": "Run tests|Fixture|ResourceState.ResourceConfig.mapScopedConfig",
      "detail": "Run the ALL ResourceState.ResourceConfig.mapScopedConfig Fixtures Tests",
      "icon": {
        "id": "run-all"
      },
      "dependsOn": [
        "Prepare TEST environment",
        "Pretest|Fixture"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/run-tests.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CONFIG_FILE": ".vscode-test/vscode-fixture-tests.mjs",
          "OUT_DIR": "~out-test",
          "SUT_EXT": "~stripped",
          "SUT_TEST": "test-ResourceState.ResourceConfig.mapScopedConfig",
          "TESTS": "*::*",
          "VSC_PROFILE": "Task Cockpit Test",
          // "VSC_VERSION": "1.116.0",
          "VSC_DATA_DIR": "~vsc-data-dir",
          "REPORTER": "spec",
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Test Failes",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\s*at [^\\s]+ \\((.+):(\\d+):(\\d+)\\)",
          "message": 0,
          "file": 1,
          "line": 2,
          "column": 3
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
    {
      "label": "Clear test failures from panel",
      "detail": "Remove test failure entries from the Problems panel",
      "icon": {
        "id": "clear-all",
        "color": "terminal.ansiYellow"
      },
      "type": "shell",
      "command": "true",
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Tests",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "",
          "message": 0,
          "file": 0
        }
      },
      "presentation": {
        "clear": true,
        "close": true,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Tests"
      }
    }
  ]
}
