// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open as project",
      "hide": true,
      "icon": {
        "id": "vscode",
        "color": "terminal.ansiBlue"
      },
      "detail": "Open current workspace in a new Codium window",
      "type": "shell",
      "command": "setsid -f codium '${workspaceFolder}' && sleep 3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "close": true,
        "group": "run-external"
      }
    },
    {
      "label": "Prepare TEST environment",
      "detail": "Set up environment variables and directories for test runs",
      "icon": {
        "id": "symbol-event"
      },
      "dependsOn": [
        "Clear"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/prepare-test-env.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_BASE": "../Task Cockpit/src"
        }
      },
      "presentation": {},
      "problemMatcher": []
    },
    {
      "label": "Clear",
      "detail": "Clear and recreate all output, test, and stripped directories",
      "icon": {
        "id": "eraser"
      },
      "dependsOn": [
        "Clear|Clean/create '~out/'",
        "Clear|Clean/create '~out-test/'",
        "Clear|Clean/create '~stripped/'"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "Clear"
      }
    },
    {
      "label": "Clear|Clean/create '~out/'",
      "detail": "Ensure '~out' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "Clear|Clean/create '~out-test/'",
      "detail": "Ensure '~out-test' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out-test"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "Clear|Clean/create '~stripped/'",
      "detail": "Ensure '~stripped' directory exists and is empty",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~stripped"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "close": true
      }
    },
    {
      "label": "Build DEBUG extension|Buid",
      "icon": {
        "id": "build"
      },
      "detail": "Compile TypeScript sources into `~out/` for debug runner",
      "dependsOn": [
        "Prepare TEST environment",
        "Clear|Clean/create '~out/'"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/transpile-typescript.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "WORK_DIR": ".",
          "DEST_DIR": "~out",
          "TSCONFIG": "debug.tsconfig.jsonc"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "base": "$tsc"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "build"
      }
    },
    {
      "label": "Build DEBUG extension|Copy `package.json`",
      "icon": {
        "id": "copy"
      },
      "detail": "",
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/copy-files.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_DIR": ".",
          "DEST_DIR": "~out",
          "INCLUDES": "package.json"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "build"
      }
    },
    {
      "label": "Build DEBUG extension",
      "icon": {
        "id": "debug"
      },
      "dependsOn": [
        "Prepare TEST environment",
        "Build DEBUG extension|Buid",
        "Build DEBUG extension|Copy `package.json`"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Pretest|Strip DEBUG blocks",
      "icon": {
        "id": "regex"
      },
      "detail": "Remove debug-only code blocks from sources `src/` into `~stripped/`  \n`rc/Logger.ts` copy skipp",
      "type": "shell",
      "command": "dev-scripts/strip-debug-blocks.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_DIR": "src",
          "DEST_DIR": "~stripped/",
          "FIND_FILTERS": "-name '~*' -prune -o -wholename 'src/*.ts' ! -wholename 'src/Logger.ts'",
          "STRIP_MODE": "test"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Prepare `package.json` for test runner",
      "detail": "",
      "icon": {
        "id": "json"
      },
      "type": "shell",
      "command": "dev-scripts/prepare-test-package.json.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out-test",
          "EXTENSION_JS": "~stripped/extension-test.js"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Unit",
      "detail": "Run all pretest steps: clear, compile test sources, strip debug blocks, build stripped extension, copy necessary files",
      "icon": {
        "id": "flame",
        "color": "terminal.ansiCyan"
      },
      "dependsOn": [
        "Pretest|Strip DEBUG blocks",
        "Pretest|Unit|Compile Unit Test .ts Files into '~out-test/'",
        "Pretest|Prepare `package.json` for test runner"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Unit|Compile Unit Test .ts Files into '~out-test/'",
      "detail": "Compile test TypeScript sources into the '~out-test' directory",
      "icon": {
        "id": "debug"
      },
      "dependsOn": [],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/transpile-typescript.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "WORK_DIR": "${workspaceFolder}",
          "TSCONFIG": "test.unit.tsconfig.jsonc",
          "OUT_DIR": "~out-test"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "base": "$tsc"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Fixture",
      "detail": "Run all pretest steps: clear, compile test sources, strip debug blocks, build stripped extension, copy necessary files",
      "icon": {
        "id": "flame",
        "color": "terminal.ansiMagenta"
      },
      "dependsOn": [
        "Pretest|Strip DEBUG blocks",
        "Pretest|Fixture|Compile Fixture test ts files into '~out-test/'",
        "Pretest|Prepare `package.json` for test runner"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Pretest|Fixture|Compile Fixture test ts files into '~out-test/'",
      "detail": "Compile test TypeScript sources into the '~out-test' directory",
      "icon": {
        "id": "debug"
      },
      "dependsOn": [],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/transpile-typescript.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "WORK_DIR": "${workspaceFolder}",
          "TSCONFIG": "test.fixture.tsconfig.jsonc",
          "OUT_DIR": "~out-test"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "base": "$tsc"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "Pretest"
      }
    },
    {
      "label": "Run tests|Fixture|Configuration",
      "detail": "Run the ALL Configuration Fixtures Tests",
      "icon": {
        "id": "run-all"
      },
      "dependsOn": [
        "Prepare TEST environment",
        "Pretest|Fixture"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/run-tests.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CONFIG_FILE": ".vscode-test/vscode-fixture-tests.mjs",
          "OUT_DIR": "~out-test",
          "SUT_EXT": "~stripped",
          "SUT_TEST": "test-Configuration",
          "TESTS": "*::*",
          "VSC_PROFILE": "Task Cockpit Test",
          // "VSC_VERSION": "1.116.0",
          "VSC_DATA_DIR": "~vsc-data-dir",
          "REPORTER": "spec",
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "owner": "Test Failes",
        "source": "vscode-test",
        "severity": "error",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^\\s*at [^\\s]+ \\((.+):(\\d+):(\\d+)\\)",
          "message": 0,
          "file": 1,
          "line": 2,
          "column": 3
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "never",
        "group": "Tests"
      }
    },
{
