{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "attach",
            "name": "Attach: Extension Host",
            "port": 9229,
            "restart": true,
            "timeout": 120000,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceFolder}/~out-sandbox/**/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**",
                // .vscode-test/*/resources/app/out/bootstrap-fork.js -- этот нужен
                "${workspaceFolder}/.vscode-test/**/app/extensions/**/*",
                "${workspaceFolder}/.vscode-test/**/vs/**/*",
                "${workspaceFolder}/node_modules/**/*"
            ]
        }
    ]
}
