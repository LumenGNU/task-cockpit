{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"incremental": false,
		"sourceMap": true,
		"rootDir": "~stripped",
		"strict": true,
		"removeComments": true,
		"noUncheckedIndexedAccess": true,
		"types": [
			"node",
			"mocha"
		]
	},
    "include": [
        "~stripped/**/*.ts"
    ],
	"exclude": [
		"**/~*.*"
	]
}
