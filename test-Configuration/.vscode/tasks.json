{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open as project",
      "hide": true,
      "icon": {
        "id": "vscode",
        "color": "terminal.ansiBlue"
      },
      "detail": "",
      "type": "shell",
      "command": "setsid -f codium '${workspaceFolder}' && sleep 3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "close": true,
        "group": "run-external"
      }
    },
    {
      "label": "Clear",
      "icon": {
        "id": "eraser"
      },
      "dependsOn": [
        "Clear|Clean/create '~coverage-reports/'",
        "Clear|Clean/create '~coverage-summary/'",
        "Clear|Clean/create '~out/'",
        "Clear|Clean/create '~out-test/'",
        "Clear|Clean/create '~stripped/'",
        "Clear|Clean/create '~test-reports/'"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "Clear"
      }
    },
    {
      "label": "Clear|Clean/create '~coverage-reports/'",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~coverage-reports"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem"
