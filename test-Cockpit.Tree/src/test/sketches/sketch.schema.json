{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Sketch",
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "sketch", "expectedRender"],
    "properties": {
        "title": { "type": "string", "minLength": 1 },
        "expectedRender": {
            "type": "object",
            "additionalProperties": false,
            "required": ["formatter", "snapshot"],
            "properties": {
                "formatter": { "$ref": "#/definitions/formatterName" },
                "snapshot": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "sketch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scopes"],
            "properties": {
                "scopes": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "$ref": "#/definitions/scopeEntry" }
                },
                "pinned": { "$ref": "#/definitions/pinnedConfig" },
                "treeConfig": { "$ref": "#/definitions/treeConfig" },
                "nodeConfig": { "$ref": "#/definitions/nodeConfig" },
                "excludeFolders": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        }
    },

    "definitions": {

        "scopeEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tasksFile", "tasks"],
            "properties": {
                "tasksFile": {
                    "type": "string",
                    "pattern": "(\\.vscode/tasks\\.json|\\.code-workspace)$"
                },
                "tasks": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/task" }
                },
                "pinned": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                }
            }
        },

        "task": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "hidden": { "type": "boolean" },
                "rejectFlag": { "type": "boolean" },
                "isBackground": { "type": "boolean" },
                "icon": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "id": { "type": "string" },
                        "color": { "type": "string" }
                    }
                },
                "group": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind"],
                    "properties": {
                        "kind": { "enum": ["Build", "Test", "Clean"] },
                        "isDefault": { "type": "boolean" }
                    }
                }
            }
        },

        "pinnedConfig": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "visibility": { "enum": ["AUTO", "HIDE"] },
                "compressionBehavior": { "enum": ["NORMAL", "SMART"] },
                "stales": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["scopeName", "label"],
                        "properties": {
                            "scopeName": { "type": "string", "minLength": 1 },
                            "label": { "type": "string", "minLength": 1 }
                        }
                    }
                }
            }
        },

        "treeConfig": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "segmentSeparator": {
                    "oneOf": [
                        { "type": "string" },
                        { "const": false }
                    ]
                },
                "useGroupKind": { "type": "boolean" },
                "showHidden": { "type": "boolean" }
            }
        },

        "nodeConfig": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "useFolderIcon": { "type": "boolean" },
                "defaultIconName": { "type": "string" },
                "tintLabel": { "type": "boolean" }
            }
        },

        "formatterName": {
            "enum": ["simple", "icon", "description"]
        }
    }
}