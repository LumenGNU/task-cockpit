// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open as project",
      "icon": {
        "id": "vscode",
        "color": "terminal.ansiBlue"
      },
      "detail": "",
      "type": "shell",
      "command": "setsid -f codium '${workspaceFolder}' && sleep 3",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "close": true,
        "group": "run-external"
      }
    },
    {
      "label": "Prepare Test Environvent",
      "icon": {
        "id": "symbol-event"
      },
      "type": "shell",
      "command": "dev-scripts/prepare-test-env.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_BASE": "../Task Cockpit/src"
        }
      },
      "presentation": {
        "panel": "shared",
        "group": "environment",
        "focus": true,
        "clear": true,
        "echo": false,
        "showReuseMessage": true
      }
    },
    {
      "label": "Build test extension",
      "icon": {
        "id": "debug"
      },
      "detail": "Compile TypeScript sources into `~out/` for test runner",
      "dependsOn": [
        "Prepare Test Environvent",
        "Build test extension|create '~out/'",
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/transpile-typescript.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out",
          "TSCONFIG": "tsconfig.json"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "base": "$tsc"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "build"
      }
    },
    {
      "label": "Build test extension|create '~out/'",
      "icon": {
        "id": "new-folder"
      },
      "detail": "Ensure clean `~out/` directory exists before compilation",
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "build"
      }
    },
    {
      "label": "(Pre Test)",
      "icon": {
        "id": "package"
      },
      "detail": "Full preparation pipeline:\n - clean directories\n - strip debug blocks\n - compile with dist config",
      "dependsOn": [
        "Prepare Test Environvent",
        "_cleanTerminal_pre-test",
        "(Pre Test)|create '~stripped/'",
        "(Pre Test)|create '~out/'",
        "(Pre Test)|strip debug blocks"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "dev-scripts/transpile-typescript.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "TSCONFIG": "dist.tsconfig.json",
          "DEST_DIR": "~out"
        }
      },
      "problemMatcher": {
        "applyTo": "allDocuments",
        "base": "$tsc"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "pre-test"
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "warn"
      }
    },
    {
      "label": "_cleanTerminal_pre-test",
      "type": "shell",
      "command": "exit 0",
      "hide": true,
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "pre-test",
      }
    },
    {
      "label": "(Pre Test)|create '~stripped/'",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~stripped"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "pre-test"
      }
    },
    {
      "label": "(Pre Test)|create '~out/'",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~out"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "pre-test"
      }
    },
    {
      "label": "(Pre Test)|strip debug blocks",
      "icon": {
        "id": "regex"
      },
      "detail": "Remove debug-only code blocks from sources into `~stripped/`",
      "type": "shell",
      "command": "dev-scripts/strip-debug-blocks.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_DIR": "src",
          "DEST_DIR": "~stripped",
          "FIND_FILTERS": "-name '~*' -prune -o -wholename 'src/*.ts'",
          "STRIP_MODE": "test"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "pre-test"
      }
    },
    {
      "label": "Run tests",
      "icon": {
        "id": "run-all"
      },
      "detail": "Sequential test run across all workspace configurations",
      "dependsOn": [
        "_cleanTerminal_test",
        "Run tests|Multi-root Tests",
        "Run tests|Single-empty-folder Tests",
        "Run tests|Single-folder Tests",
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "echo -e \"\\\\e[1m[DONE] Testing finished\\\\e[0m\\\\n\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "test",
      }
    },
    {
      "label": "(Pre Test)|create '~test-results'",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~test-results"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "pre-test"
      }
    },
    {
      "label": "_cleanTerminal_test",
      "type": "shell",
      "command": "echo -e \"\\\\e[1m[TEST] Testing started ($(date)) ...\\\\e[0m\\\\n\"",
      "hide": true,
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "test",
      }
    },
    {
      "label": "Run tests|Multi-root Tests",
      "icon": {
        "id": "beaker"
      },
      "detail": "Integration tests for multi-root workspace scenarios",
      "dependsOn": "(Pre Test)",
      "type": "shell",
      "command": [
        "trap 'echo -e \"\\\\n\\\\e[31mProcess terminated\\\\e[0m\" ; exit 1' TERM INT; ",
        "npx vscode-test ",
        "--coverage ",
        "--coverage-output '~coverage-reports/Multi-root' ",
        "--coverage-reporter json ",
        "--config './vscode-test.mjs' ",
        "--label 'Multi-root Tests'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "test",
      }
    },
    {
      "label": "Run tests|Single-empty-folder Tests",
      "icon": {
        "id": "beaker"
      },
      "detail": "Integration tests with an empty workspace folder",
      "dependsOn": "(Pre Test)",
      "type": "shell",
      "command": [
        "trap 'echo -e \"\\\\n\\\\e[31mProcess terminated\\\\e[0m\" ; exit 1' TERM INT; ",
        "npx vscode-test ",
        "--coverage ",
        "--coverage-output '~coverage-reports/Single-empty-folder' ",
        "--coverage-reporter json ",
        "--config './vscode-test.mjs' ",
        "--label 'Single-empty-folder Tests'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "test"
      }
    },
    {
      "label": "Run tests|Single-folder Tests",
      "icon": {
        "id": "beaker"
      },
      "detail": "Integration tests for single-folder workspace",
      "dependsOn": "(Pre Test)",
      "type": "shell",
      "command": [
        "trap 'echo -e \"\\\\n\\\\e[31mProcess terminated\\\\e[0m\" ; exit 1' TERM INT; ",
        "npx vscode-test ",
        "--coverage ",
        "--coverage-output '~coverage-reports/Single-folder' ",
        "--coverage-reporter json ",
        "--config './vscode-test.mjs' ",
        "--label 'Single-folder Tests'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "test"
      }
    },
    {
      "label": "Run tests|Core|Tasks",
      "icon": {
        "id": "beaker"
      },
      "detail": "",
      "dependsOn": [
        "(Pre Test)",
        "(Pre Test)|create '~test-results'"
      ],
      "type": "shell",
      "command": [
        "dev-scripts/run-test-fixtures.bash ; code=$? ; ",
        "dev-scripts/mocha-report-in-terminal.bash ; exit $code"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RESULTS_DIR": "~test-results",
          "MOCHA_TEST_FILTER": "Core.Tasks"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "test"
      }
    },
    {
      "label": "Generate summary coverage report",
      "icon": {
        "id": "run-all-coverage"
      },
      "detail": "Clean, run all tests with coverage, then merge reports into a single summary",
      "dependsOn": [
        "Generate summary coverage report|create '~coverage-reports/'",
        "Generate summary coverage report|create '~coverage-summary/'",
        "Generate summary coverage report|Run all tests",
        "Generate summary coverage report|Merge reports"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "coverage"
      }
    },
    {
      "label": "Generate summary coverage report|create '~coverage-reports/'",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~coverage-reports"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "coverage"
      }
    },
    {
      "label": "Generate summary coverage report|create '~coverage-summary/'",
      "icon": {
        "id": "new-folder"
      },
      "type": "shell",
      "command": "dev-scripts/create-empty-directory.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DEST_DIR": "~coverage-summary"
        }
      },
      "presentation": {
        "clear": false,
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "revealProblems": "onProblem",
        "group": "coverage"
      }
    },
    {
      "label": "Generate summary coverage report|Run all tests",
      "icon": {
        "id": "run-all"
      },
      "detail": "Trigger the full test suite with coverage collection enabled",
      "dependsOn": [
        "Run tests"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Generate summary coverage report|Merge reports",
      "icon": {
        "id": "git-merge"
      },
      "detail": "Combine per-configuration coverage JSONs into an HTML summary",
      "type": "shell",
      "command": "dev-scripts/merge-coverage.bash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "IN_DIR": "~coverage-reports",
          "OUT_DIR": "~coverage-summary"
        }
      },
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "revealProblems": "onProblem",
        "group": "coverage"
      }
    },
    {
      "label": "Open coverage report",
      "icon": {
        "id": "browser"
      },
      "detail": "Open the merged HTML coverage report in the default browser",
      "type": "shell",
      "command": "setsid -f x-www-browser '${workspaceFolder}/~coverage-summary/index.html' && sleep 3",
      "presentation": {
        "clear": true,
        "echo": false,
        "reveal": "never",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "close": true,
        "group": "run"
      }
    }
  ],
}