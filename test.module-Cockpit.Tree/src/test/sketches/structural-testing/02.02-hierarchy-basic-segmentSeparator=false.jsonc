
// Базовая иерархия через separator.
{
    "title": "hierarchy · separator disabled",
    "sketch": {
        "scopes": {
            "scope": ".vscode/tasks.json"
        },
        "tasks": {
            "scope": [
                { "name": "AAA:in-aaa-1" },
                { "name": "AAA:in-aaa-2" },
                { "name": "BBB:in-bbb-1" },
                { "name": "BBB:in-bbb-2" },
                { "name": "ccc"    }
            ]
        },
        "treeConfig": {
            "segmentSeparator": false // сепаратор отключен
        }
    },
    "asciiTree": [
        "[F[ scope ]]       ",
        " ├─ ▶ AAA:in-aaa-1 ",
        " ├─ ▶ AAA:in-aaa-2 ",
        " ├─ ▶ BBB:in-bbb-1 ",
        " ├─ ▶ BBB:in-bbb-2 ",        
        " └─ ▶ ccc          "
    ]
}