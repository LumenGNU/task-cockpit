
// Pinned с глубокой иерархией — path compression, режим SMART.
// Проверяет: схлопываются и цепочки группа→группа (BBB › CCC, DDD › EEE, FFF › GGG),
// и цепочки группа→задача (side-FFF › task3, side-DDD › task4, side-BBB › task5).
//
// Задействованные настройки: segmentSeparator=":", compressionBehavior="SMART".
{
    "title": "Pinned · deep paths · SMART compression",
    "sketch": {
        "scopes": {
            "app": {
                "tasksFile": "app/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G1" },
                    { "name": "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G2" },
                    { "name": "AAA:BBB:CCC:DDD:EEE:side-FFF:task3" },
                    { "name": "AAA:BBB:CCC:side-DDD:task4" },
                    { "name": "AAA:side-BBB:task5" }
                ],
                "pinned": [
                    "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G1",
                    "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G2",
                    "AAA:BBB:CCC:DDD:EEE:side-FFF:task3",
                    "AAA:BBB:CCC:side-DDD:task4",
                    "AAA:side-BBB:task5"
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "compressionBehavior": "SMART"
        }
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "[★[ Pinned ]]                      ",
            " └─ AAA                            ",
            "    ├─ BBB › CCC                   ",
            "    │  ├─ DDD › EEE                ",
            "    │  │  ├─ FFF › GGG             ",
            "    │  │  │  ├─ ▶ task-G1          ",
            "    │  │  │  └─ ▶ task-G2          ",
            "    │  │  └─ ▶ side-FFF › task3    ",
            "    │  └─ ▶ side-DDD › task4       ",
            "    └─ ▶ side-BBB › task5          ",
            "                                   ",
            "[F[ app ]]                         ",
            " └─ AAA                            ",
            "    ├─ BBB                         ",
            "    │  └─ CCC                      ",
            "    │     ├─ DDD                   ",
            "    │     │  └─ EEE                ",
            "    │     │     ├─ FFF             ",
            "    │     │     │  └─ GGG          ",
            "    │     │     │     ├─ ▶ task-G1 ",
            "    │     │     │     └─ ▶ task-G2 ",
            "    │     │     └─ side-FFF        ",
            "    │     │        └─ ▶ task3      ",
            "    │     └─ side-DDD              ",
            "    │        └─ ▶ task4            ",
            "    └─ side-BBB                    ",
            "       └─ ▶ task5                  "
        ]
    }
}
