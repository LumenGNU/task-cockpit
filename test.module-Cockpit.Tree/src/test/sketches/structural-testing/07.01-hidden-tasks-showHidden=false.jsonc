
// Скрытые задачи и взаимодействие с showHidden.
// Проверяет:
// 1) hidden задачи не отображаются при showHidden: false
// 2) hidden лист внутри ветки — ветка остаётся, лист исчезает
// 3) плоский hidden — просто отсутствует
//
{
    "title": "hidden tasks · excluded",
    "sketch": {
        "scopes": {
            "scope": "scope/.vscode/tasks.json"
        },
        "tasks": {
            "scope": [
                { "name": "AAA:visible" },
                { "name": "AAA:HIDDEN", "hidden": true },
                { "name": "BBB:CCC:visible" },
                { "name": "BBB:b:bb:bbb:HIDDEN", "hidden": true }, // пути b:bb:bbb не будет построено
                { "name": "HIDDEN-tool", "hidden": true },
                { "name": "FFF:segment&task", "hidden": true }, // segment&task как задача - скрыта
                { "name": "FFF:segment&task:visible" },         // segment&task как группирующий сегмент - видим
                { "name": "HIDDEN:tool", "hidden": true }
            ]
        },
        "treeConfig": { "showHidden": false, "segmentSeparator": ":"}
    },
    "asciiTree": [
        "[F[ scope ]]         ",
        " ├─ AAA              ",
        " │  └─ ▶ visible     ",
        " ├─ BBB              ",
        " │  └─ CCC           ",
        " │     └─ ▶ visible  ",
        " └─ FFF              ",
        "    └─ segment&task  ", // не задача, только группа
        "       └─ ▶ visible  "
    ]
}
