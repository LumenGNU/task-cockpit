
// Pinned: single-folder, visibility=AUTO.
// Проверяет:
// - секция Pinned появляется при наличии refs (AUTO)
// - корректное разрешение ref'ов в дереве
// - порядок Pinned соответствует порядку в массиве refs (не порядку задач в файле)
//
// Задействованные настройки: segmentSeparator=":" (иерархия по сегментам).
{
    "title": "Pinned · single-folder AUTO visibility",
    "sketch": {
        "scopes": {
            "app": "app/.vscode/tasks.json"
        },
        "tasks": {
            "app": [
                { "name": "build:dev" },
                { "name": "build:prod" },
                { "name": "test:unit" },
                { "name": "test:e2e" },
                { "name": "lint" }
            ]
        },
        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "visibility": "AUTO",
            "refs": [
                { "scope": "app", "label": "lint" },
                { "scope": "app", "label": "test:e2e" },
                { "scope": "app", "label": "build:prod" },
                { "scope": "app", "label": "build:dev" }
            ]
        }
    },
    "asciiTree": [
        "[★[ Pinned ]]  ",
        " ├─ ▶ lint     ",
        " ├─ test       ",
        " │  └─ ▶ e2e   ",
        " └─ build      ",
        "    ├─ ▶ prod   ",
        "    └─ ▶ dev    ",
        "                ",
        "[F[ app ]]     ",
        " ├─ build      ",
        " │  ├─ ▶ dev   ",
        " │  └─ ▶ prod  ",
        " ├─ test       ",
        " │  ├─ ▶ unit  ",
        " │  └─ ▶ e2e   ",
        " └─ ▶ lint     "
    ]
}