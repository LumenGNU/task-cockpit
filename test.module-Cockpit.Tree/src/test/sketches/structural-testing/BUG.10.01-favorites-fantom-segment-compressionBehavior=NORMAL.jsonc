{
    "title": "BUG phantom segment in pinned · NORMAL compression",
    "sketch": {
        "scopes": {
            "scope1": {
                "tasksFile": "scope1/.vscode/tasks.json",
                "tasks": [
                    { "name": "aaa:bbb:ccc:task-in-ccc" },
                    { "name": "aaa:bbb:ccc:ddd:task-in-ddd" }
                ],
                // BUG: (решено) Section::buildCompressedPath
                // Без guard'а reverseAndJoin() породит фантомный пустой сегмент.
                "pinned": [
                    "aaa:bbb:ccc:ddd:task-in-ddd",
                    "aaa:bbb:ccc:task-in-ccc"
                ]
            },
            "scope2": {
                "tasksFile": "scope2/.vscode/tasks.json",
                "tasks": [
                    { "name": "aaa:bbb:ccc:task-in-ccc" },
                    { "name": "aaa:bbb:ccc:ddd:task-in-ddd" }
                ],
                // --- разный порядок, для проверки ---
                "pinned": [
                    "aaa:bbb:ccc:task-in-ccc",
                    "aaa:bbb:ccc:ddd:task-in-ddd"
                ]
            }
        },

        "treeConfig": {
            "segmentSeparator": ":"
        },

        "pinned": {
            "compressionBehavior": "NORMAL"
        }
        
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "[★[ Pinned ]]                  ",
            " ├─ [ scope1 ]                 ",
            " │  └─ aaa › bbb › ccc            ",
            " │     ├─ ddd                  ",
            " │     │  └─ ▶ task-in-ddd     ", // BUG`а нет
            " │     └─ ▶ task-in-ccc        ",
            " └─ [ scope2 ]                 ",
            "    └─ aaa › bbb › ccc            ",
            "       ├─ ▶ task-in-ccc        ",
            "       └─ ddd                  ",
            "          └─ ▶ task-in-ddd     ", // BUG`а нет
            "                               ",
            "[F[ scope1 ]]                  ",
            " └─ aaa                        ",
            "    └─ bbb                     ",
            "       └─ ccc                  ",
            "          ├─ ▶ task-in-ccc     ",
            "          └─ ddd               ",
            "             └─ ▶ task-in-ddd  ",
            "                               ",
            "[F[ scope2 ]]                  ",
            " └─ aaa                        ",
            "    └─ bbb                     ",
            "       └─ ccc                  ",
            "          ├─ ▶ task-in-ccc     ",
