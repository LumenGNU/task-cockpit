
{
    "title": "excludeFolders · workspace-level",
    "sketch": {

        "scopes": {
            // (не видно в дереве)
            "project (workspace)": {
                "tasksFile": "project.code-workspace",
                "tasks": []
            },
            "f1": {
                "tasksFile": "f1/.vscode/tasks.json",
                "tasks": [
                    { "name": "in-f1" }
                ]
            },
            // (не видно в дереве)
            "excluded": {
                "tasksFile": "excluded/.vscode/tasks.json",
                "tasks": [
                    { "name": "in-excluded" }
                ]
            },
            "f2": {
                "tasksFile": "f2/.vscode/tasks.json",
                "tasks": [
                    { "name": "in-f2" }
                ]
            }
        },

        "excludeFolders": ["excluded", "project (workspace)"]
    },
    "asciiTree": [
        "[F[ f1 ]]      ",
        " └─ ▶ in-f1    ",
        "               ", // excluded исключена
        "[F[ f2 ]]      ",
        " └─ ▶ in-f2    "
    ]
}