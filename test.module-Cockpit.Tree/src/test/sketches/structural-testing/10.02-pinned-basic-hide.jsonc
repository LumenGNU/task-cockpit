
// Pinned: single-folder, visibility=HIDE.
// Проверяет: секция Pinned скрыта при наличии живых refs (HIDE).
// Рабочие refs есть — раздел не отображается.
{
    "title": "Pinned · single-folder HIDE visibility",
    "sketch": {
        "scopes": {
            "app": {
                "tasksFile": "app/.vscode/tasks.json",
                "tasks": [
                    { "name": "task-1" },
                    { "name": "task-2" },
                    { "name": "task-3" }
                ],
                "pinned": [
                    "task-1",
                    "task-2"
                ]
            }
        },

        "pinned": {
            "visibility": "HIDE"
        }
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "[F[ app ]]   ",
            " ├─ ▶ task-1 ",
            " ├─ ▶ task-2 ",
            " └─ ▶ task-3 "
        ]
    }
}