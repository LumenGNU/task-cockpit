
// Pinned с глубокой иерархией — path compression, режим NORMAL.
// Проверяет: однодетные цепочки группа→группа схлопываются (BBB › CCC, DDD › EEE, FFF › GGG),
// цепочки группа→задача не схлопываются (side-FFF/task3, side-DDD/task4, side-BBB/task5).
//
// Задействованные настройки: segmentSeparator=":", compressionBehavior="NORMAL".
{
    "title": "Pinned · deep paths · NORMAL compression",
    "sketch": {
        "scopes": {
            "app": {
                "tasksFile": "app/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G1" },
                    { "name": "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G2" },
                    { "name": "AAA:BBB:CCC:DDD:EEE:side-FFF:task3" },
                    { "name": "AAA:BBB:CCC:side-DDD:task4" },
                    { "name": "AAA:side-BBB:task5" }
                ],
                "pinned": [
                    "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G1",
                    "AAA:BBB:CCC:DDD:EEE:FFF:GGG:task-G2",
                    "AAA:BBB:CCC:DDD:EEE:side-FFF:task3",
                    "AAA:BBB:CCC:side-DDD:task4",
                    "AAA:side-BBB:task5"
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "compressionBehavior": "NORMAL"
        }
    },
    "asciiTree": [
        "[★[ Pinned ]]                      ",
        " └─ AAA                            ",
        "    ├─ BBB › CCC                   ",
        "    │  ├─ DDD › EEE                ",
        "    │  │  ├─ FFF › GGG             ",
        "    │  │  │  ├─ ▶ task-G1          ",
        "    │  │  │  └─ ▶ task-G2          ",
        "    │  │  └─ side-FFF              ",
        "    │  │     └─ ▶ task3            ",
        "    │  └─ side-DDD                 ",
        "    │     └─ ▶ task4               ",
        "    └─ side-BBB                    ",
        "       └─ ▶ task5                  ",
        "                                   ",
        "[F[ app ]]                         ",
        " └─ AAA                            ",
        "    ├─ BBB                         ",
        "    │  └─ CCC                      ",
        "    │     ├─ DDD                   ",
        "    │     │  └─ EEE                ",
        "    │     │     ├─ FFF             ",
        "    │     │     │  └─ GGG          ",
        "    │     │     │     ├─ ▶ task-G1 ",
        "    │     │     │     └─ ▶ task-G2 ",
        "    │     │     └─ side-FFF        ",
        "    │     │        └─ ▶ task3      ",
        "    │     └─ side-DDD              ",
        "    │        └─ ▶ task4            ",
        "    └─ side-BBB                    ",
        "       └─ ▶ task5                  "
    ]
}
