
// Pinned · SMART compression на неадекватно глубокой вложенности.
// Все 5 задач закреплены. Цепочки длиной 6–9 сегментов.
// Проверяет: SMART корректно сжимает длинные линейные цепочки,
// не сжимает узлы с несколькими детьми в pinned-дереве.
//
// Задействованные настройки: segmentSeparator=":", compressionBehavior="SMART".
{
    "title": "Pinned · SMART compression on absurdly deep nesting",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "a:b:c:d:e:f:g:h:k:l:m:n:o:p:r:s:t:x:y:z:task-2" },
                    { "name": "a:b:c:d:e:f:g:h:k:l:m:n:o:p:r:s:t:x:y:z:task-3" },
                    { "name": "S:a:b:c:d:e:f:g:h:k:l:m:n:o:p:r:s:t:x:y:z:task-1" },
                    { "name": "a:b:c:d:e:g:h:task-4" },
                    { "name": "x:y:z:task-5" }
                ],
                "pinned": [
                    "a:b:c:d:e:f:g:h:k:l:m:n:o:p:r:s:t:x:y:z:task-2",
                    "a:b:c:d:e:f:g:h:k:l:m:n:o:p:r:s:t:x:y:z:task-3",
                    "S:a:b:c:d:e:f:g:h:k:l:m:n:o:p:r:s:t:x:y:z:task-1",
                    "a:b:c:d:e:g:h:task-4",
                    "x:y:z:task-5"
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "compressionBehavior": "SMART"
        }
    },
    "expectedRender": {
        "formatter": "simple",
