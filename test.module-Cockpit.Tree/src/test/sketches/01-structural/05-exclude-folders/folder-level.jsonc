
{
    "title": "Exclude folders · folder-level",
    "sketch": {

        "scopes": {
            "project (workspace)": {
                "tasksFile": "project.code-workspace",
                "tasks": []
            },
            "f1": {
                "tasksFile": "f1/.vscode/tasks.json",
                "tasks": [
                    { "name": "in-f1" }
                ]
            },
            // (не видно в дереве)
            "excluded": {
                "tasksFile": "excluded/.vscode/tasks.json",
                "tasks": [
                    { "name": "in-excluded" }
                ]
            },
            "f2": {
                "tasksFile": "f2/.vscode/tasks.json",
                "tasks": [
                    { "name": "in-f2" }
                ]
            }
        },

        "excludeFolders": ["excluded"]
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[W[ project (workspace) ]]                  ",
            "  └─ « No tasks to display in this scope »   ",
            "                                             ",
            "━[F[ f1 ]]                                   ",
            "  └─ ▶ in-f1                                 ",
            "                                             ",
            "━[F[ f2 ]]                                   ",
            "  └─ ▶ in-f2                                 "
        ]
    }
}