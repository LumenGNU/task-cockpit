
// Базовая иерархия через separator.
{
    "title": "Hierarchy · colon separator",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": ".vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:in-aaa-1" },
                    { "name": "AAA:in-aaa-2" },
                    { "name": "BBB:in-bbb-1" },
                    { "name": "BBB:in-bbb-2" },
                    { "name": "ccc" }
                ]
            }
        },
        
        "treeConfig": {
            "segmentSeparator": ":"
        }
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[F[ scope ]]       ",
            "  ├─ AAA            ",
            "  │  ├─ ▶ in-aaa-1  ",
            "  │  └─ ▶ in-aaa-2  ",
            "  ├─ BBB            ",
            "  │  ├─ ▶ in-bbb-1  ",
            "  │  └─ ▶ in-bbb-2  ",
            "  └─ ▶ ccc          "
        ]
    }
}