
// 
{
    "title": "hierarchy · separator edge cases",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": ".vscode/tasks.json",
                "tasks": [
                    { "name": "AAA/in-aaa" },
                    { "name": "AAA//flat"  },
                    { "name": "AAA /flat"  },
                    { "name": "AAA flat/"  },
                    { "name": "/FLAT"      },
                    { "name": "FLAT/"      },
                    { "name": "/FLAT/"     }
                ]
            }
        },

        "treeConfig": {
            "segmentSeparator": "/"
        }
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[F[ scope ]]        ",
            "  ├─ AAA             ",
            "  │  └─ ▶ in-aaa     ", // единственный сработавший разделитель
            "  ├─ ▶ AAA//flat     ",
            "  ├─ ▶ AAA /flat     ",
            "  ├─ ▶ AAA flat/     ",
            "  ├─ ▶ /FLAT         ",
            "  ├─ ▶ FLAT/         ",
            "  └─ ▶ /FLAT/        "
        ]
    }
}