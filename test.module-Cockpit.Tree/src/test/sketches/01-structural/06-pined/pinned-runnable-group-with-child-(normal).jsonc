
// Закреплённый узел, который одновременно является родителем другого закреплённого узла.
//
// Проверяем:
// - в NORMAL-режиме path compression не «втягивает» Runnable Parent
//   в сжатую строку предков — иначе его путь не совпадёт с путём ребёнка
//   и они окажутся в разных ветках дерева (дубль вместо вложенности).
{
    "title": "Pinned · pinned task with pinned child · NORMAL compression",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:Runnable Parent" },
                    { "name": "AAA:BBB:Runnable Parent:Sub Task" }
                ],
                "pinned": [
                    "AAA:BBB:Runnable Parent",         // родительский узел — runnable и имеет детей
                    "AAA:BBB:Runnable Parent:Sub Task" // его ребёнок. Оба закреплены в Pinned.
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "compressionBehavior": "NORMAL"
        }

    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[★[ Pinned ]]                   ",
            "  └─ AAA › BBB                     ",
            "     └─ ▶ Runnable Parent         ",
            "        └─ ▶ Sub Task             ",
            "                                 ",
            "━[F[ scope ]]                    ",
            "  └─ AAA                         ",
            "     └─ BBB                      ",
            "        └─ ▶ Runnable Parent     ",
            "           └─ ▶ Sub Task         "
        ]
    }
}
