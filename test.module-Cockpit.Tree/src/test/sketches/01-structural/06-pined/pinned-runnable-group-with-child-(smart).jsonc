
// Закреплённый узел, который одновременно является родителем другого закреплённого узла.
//
// Проверяем:
// - в SMART-режиме `Runnable Parent` трактуется как forced branch point:
//  сжимается вместе с предками в один сегмент, а ребёнок правильно вкладывается под него.
{
    "title": "Pinned · pinned task with pinned child · SMART compression",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:Runnable Parent" },
                    { "name": "AAA:BBB:Runnable Parent:Sub Task" }
                ],
                "pinned": [
                    "AAA:BBB:Runnable Parent",         // родительский узел — runnable и имеет детей
                    "AAA:BBB:Runnable Parent:Sub Task" // его ребёнок. Оба закреплены в Pinned.
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "compressionBehavior": "SMART"
        }

    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[★[ Pinned ]]                   ",
            "  └─ ▶ AAA › BBB › Runnable Parent  ",
            "     └─ ▶ Sub Task               ",
            "                                 ",
            "━[F[ scope ]]                    ",
            "  └─ AAA                         ",
            "     └─ BBB                      ",
            "        └─ ▶ Runnable Parent     ",
            "           └─ ▶ Sub Task         "
        ]
    }
}
