
// Закреплённый узел, который одновременно является родителем другого закреплённого узла.
//
// Как "pinned-runnable-group-with-child-(smart).jsonc", но с обратным порядком в `pinned` —
// на структуру дерева это не должно повлиять
{
    "title": "Pinned · pinned task with pinned child · SMART compression · reverse order",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:Runnable Parent" },
                    { "name": "AAA:BBB:Runnable Parent:Sub Task" }
                ],
                "pinned": [
                    "AAA:BBB:Runnable Parent:Sub Task",  // родительский узел — runnable и имеет детей
                    "AAA:BBB:Runnable Parent"            // его ребёнок. Оба закреплены в Pinned, но в обратном порядке.
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "compressionBehavior": "SMART"
        }

    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[★[ Pinned ]]                   ",
            "  └─ ▶ AAA › BBB › Runnable Parent  ",
            "     └─ ▶ Sub Task               ",
            "                                 ",
            "━[F[ scope ]]                    ",
            "  └─ AAA                         ",
            "     └─ BBB                      ",
            "        └─ ▶ Runnable Parent     ",
            "           └─ ▶ Sub Task         "
        ]
    }
}
