
// Pinned в multi-root: закреплённые из разных scope + битая ссылка.
// Проверяет:
// - закреплённые из разных scope отображаются под своими folder-узлами
// - битая ссылка рендерится как « ✗ ... »
// - порядок следует порядку в refs
//
// refs (порядок):
//   1. scope1 / AAA:child-task-1  ← валидный
//   2. scope2 / BBB               ← валидный
//   3. scope1 / missing-task      ← БИТАЯ ССЫЛКА (в stales)
//   4. scope2 / CCC               ← валидный
//
// Задействованные настройки: segmentSeparator=":".
{
    "title": "Pinned · multi-root with stale ref",
    "sketch": {
        "scopes": {
            "scope1": {
                "tasksFile": "scope1/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:child-task-1" },
                    { "name": "AAA:child-task-2" }
                ],
                "pinned": [
                    "AAA:child-task-1"
                ]
            },
            "scope2": {
                "tasksFile": "scope2/.vscode/tasks.json",
                "tasks": [
                    { "name": "BBB" },
                    { "name": "CCC" }
                ],
                "pinned": [
                    "BBB",
                    "CCC"
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "pinned": {
            "stales": [
                { "scopeName": "_scope1", "label": "missing-task" }
            ]
        }
    },
    "expectedRender": {
        "formatter": "simple",
        "snapshot": [
            "━[★[ Pinned ]]                              ",
            "  ├─ « ✗ missing-task »                     ",
            "  ├─ [ scope1 ]                             ",
            "  │  └─ AAA                                 ",
            "  │     └─ ▶ child-task-1                   ",
            "  └─ [ scope2 ]                             ",
            "     ├─ ▶ BBB                               ",
            "     └─ ▶ CCC                               ",
            "                                            ",
            "━[F[ scope1 ]]                              ",
            "  └─ AAA                                    ",
            "     ├─ ▶ child-task-1                      ",
            "     └─ ▶ child-task-2                      ",
            "                                            ",
            "━[F[ scope2 ]]                              ",
            "  ├─ ▶ BBB                                  ",
            "  └─ ▶ CCC                                  "
        ]
    }
}
