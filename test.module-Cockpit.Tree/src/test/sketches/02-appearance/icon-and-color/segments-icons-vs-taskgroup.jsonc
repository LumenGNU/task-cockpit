
// Задача-группа имеет свою иконку, не "symbol-folder"
{
    "title": "Icon and color · useFolderIcon=true and grouped task",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:Runnable Parent", "icon": {"id": "zap"} },
                    { "name": "AAA:BBB:Runnable Parent:task" }                    
                ],
                "pinned": [
                    "AAA:BBB:Runnable Parent",
                    "AAA:BBB:Runnable Parent:task"
                ]
            }
        },
        "treeConfig": { "segmentSeparator": ":" },
        "nodeConfig": { "useFolderIcon": true }, // использовать иконку папки для промежуточных сегментов
        "pinned": { "compressionBehavior": "NORMAL" }
    },
    "expectedRender": {
        "formatter": "icon",
        "snapshot": [
            "━[★[ Pinned ]]                          ",
            "  └─ AAA › BBB · $(symbol-folder)        ",
            "     └─ ▶ Runnable Parent · $(zap)      ", // иконка zap, не папка
            "        └─ ▶ task · $(tools)            ",
            "                                        ",
            "━[F[ scope ]]                           ",
            "  └─ AAA · $(symbol-folder)             ",
            "     └─ BBB · $(symbol-folder)          ",
            "        └─ ▶ Runnable Parent · $(zap)   ",
            "           └─ ▶ task · $(tools)         "
        ]
    }
}