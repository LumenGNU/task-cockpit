
// Задача-группа в двух контекстах: основное дерево vs Pinned.
// В основном дереве "build" — RunnableGroup, иконка задачи (package).
// В Pinned "build" — промежуточный Group-сегмент (подзадача запинована, сама нет),
// useFolderIcon=true даёт ей иконку папки, цвет не наследуется.
// Задействованные настройки: segmentSeparator=":", useFolderIcon=true,
//                            defaultIconName="tools".
{
    "title": "Icon and color · RunnableGroup icon vs Group folder icon (NORMAL)",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "build:task-1",  "icon": { "id": "zap"} },
                    { "name": "build:task-2", "icon": { "id": "play"} },
                    { "name": "build", "icon": { "id": "package", "color": ".red" } }
                ],
                "pinned": [
                    "build:task-1"
                ]
            }
        },

        "treeConfig": { "segmentSeparator": ":" },
        "nodeConfig": { "useFolderIcon": true }
    },
    "expectedRender": {
        "formatter": "icon",
        "snapshot": [
            "━[★[ Pinned ]]                 ",
            "  └─ build · $(symbol-folder)  ", // папка без цвета
            "     └─ ▶ task-1 · $(zap)      ",
            "                               ",
            "━[F[ scope ]]                  ",
            "  └─ ▶ build · $(package~.red) ", // своя иконка с цветом
            "     ├─ ▶ task-1 · $(zap)      ",
            "     └─ ▶ task-2 · $(play)     "
        ]
    }
}