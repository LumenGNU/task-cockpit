
// 
{
    "title": "Description · rejected icon and color",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "rejected", "rejectFlag": true}
                ],
                "pinned": [
                    "rejected"
                ]
            }
        }

    },
    "expectedRender": {
        "formatter": "icon",
        "snapshot": [
            "━[★[ Pinned ]] · $(pinned~list.highlightForeground)  ",
            "  └─ ▶ rejected · $(warning~list.warningForeground)  ",
            "                                                     ",
            "━[F[ scope ]] · $(root-folder)                       ",
            "  └─ ▶ rejected · $(warning~list.warningForeground)  "
        ]
    }
}