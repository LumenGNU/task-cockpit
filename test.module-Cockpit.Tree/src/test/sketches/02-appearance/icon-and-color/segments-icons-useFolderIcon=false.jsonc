
// 
{
    "title": "Icon and color · useFolderIcon=false",
    "sketch": {
        "scopes": {
            "scope": {
                "tasksFile": "scope/.vscode/tasks.json",
                "tasks": [
                    { "name": "AAA:BBB:CCC:task" }                    
                ],
                "pinned": [
                    "AAA:BBB:CCC:task"
                ]
            }
        },
        "treeConfig": {"segmentSeparator": ":"},
        "nodeConfig": { "useFolderIcon": false }
    },
    "expectedRender": {
        "formatter": "icon",
        "snapshot": [
            "━[★[ Pinned ]] · $(pinned~list.highlightForeground)   ",
            "  └─ AAA › BBB › CCC · $(-no-icon-)                      ", // промежуточное сегменты НЕ имеют иконку
            "     └─ ▶ task · $(tools)                             ",
            "                                                      ",
            "━[F[ scope ]] · $(root-folder)                        ",
            "  └─ AAA · $(-no-icon-)                               ", // промежуточное сегменты НЕ имеют иконку
            "     └─ BBB · $(-no-icon-)                            ",
            "        └─ CCC · $(-no-icon-)                         ",
            "           └─ ▶ task · $(tools)                       "
        ]
    }
}