{
  "name": "task-cockpit",
  "publisher": "papio-dev",
  "displayName": "TEST-extension",
  "description": "",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./~out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "test-extension-activate",
        "title": "test extension activate"
      },
      {
