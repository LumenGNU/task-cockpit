          "id": "test-debug-tree",
          "name": "Debug Tree"
        }
      ]
    }
  },
  "scripts": {},
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.86.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "nyc": "^18.0.0",
    "typescript": "^5.9.3"
  }
}