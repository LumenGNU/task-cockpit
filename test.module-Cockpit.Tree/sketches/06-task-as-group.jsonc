// Задача-группа: узел одновременно runnable и содержит дочерние задачи.
// Проверяет: корректное отображение задачи с данными, у которой есть потомки.
// "build" имеет и собственные данные (icon), и дочерние узлы.
// "test" — чистая группа (нет собственной задачи "test").
//
// Ожидаемое дерево:
//   build          ← runnable (есть данные) + группа
//     dev
//     prod
//     watch
//   test           ← чистая группа (implicit intermediate node)
//     unit
//     e2e
//     integration
//   deploy         ← лист, без вложенности
{
	"scopes": {
		"app": "/workspace/app/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/app/.vscode/tasks.json": [
			{ "name": "build:dev" },
			{ "name": "build:prod" },
			{ "name": "build:watch" },
			{ "name": "build", "icon": { "id": "package", "color": "terminal.ansiGreen" } },
			{ "name": "test:unit" },
			{ "name": "test:e2e" },
			{ "name": "test:integration" },
			{ "name": "deploy" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": true, "defaultIconName": "tools", "tintLabel": false }
}