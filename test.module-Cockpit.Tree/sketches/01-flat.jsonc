// Плоский список без иерархии.
// Базовый случай: все задачи на одном уровне, separator отключён.
// Проверяет: сохранение порядка из файла, рендеринг без вложенности.
{
	"scopes": {
		"app": "/workspace/app/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/app/.vscode/tasks.json": [
			{ "name": "build" },
			{ "name": "lint" },
			{ "name": "test" },
			{ "name": "deploy" },
			{ "name": "clean" }
		]
	},
	"treeConfig": { "segmentSeparator": "", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}