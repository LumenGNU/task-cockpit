// Favorites: базовый случай в single-folder.
// Проверяет:
// - появление секции Favorites при наличии записей
// - корректное разрешение favorite refs
// - порядок favorites соответствует порядку в массиве (не порядку в файле)
//
// Favorites: lint, build:prod, test:e2e (порядок отличается от файла)
{
	"scopes": {
		"app": "/workspace/app/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/app/.vscode/tasks.json": [
			{ "name": "build:dev" },
			{ "name": "build:prod" },
			{ "name": "test:unit" },
			{ "name": "test:e2e" },
			{ "name": "lint" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false },
	"favorites": {
	"refs":[
		{ "folder": "app", "label": "lint" },
		{ "folder": "app", "label": "test:e2e" },
		{ "folder": "app", "label": "build:prod" },
		{ "folder": "app", "label": "build:dev" }
	]
}
}