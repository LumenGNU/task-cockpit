// Комбинация separator + useGroupKind.
// Проверяет взаимодействие двух механизмов иерархии одновременно.
// README предупреждает о дублировании: "Build:dev" с group "build" и separator ":"
// создаёт Build → Build → dev — двойную вложенность.
//
// Сценарий содержит:
// 1) Задачи где group совпадает с prefix (проблемный случай из README)
// 2) Задачи где group НЕ совпадает с prefix (нормальный случай)
// 3) Задачу без group но с separator (только separator hierarchy)
//
// Ожидаемое дерево:
//   Build                     ← group folder
//     Build                   ← segment from "Build:dev" — дублирование!
//       dev
//       prod
//   CI                        ← group folder
//     deploy                  ← "deploy:staging" split
//       staging
//       production
//   lint → all                ← нет group, но separator
{
	"scopes": {
		"project": "/workspace/project/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/project/.vscode/tasks.json": [
			{ "name": "Build:dev", "group": { "kind": "*Build", "isDefault": false } },
			{ "name": "Build:prod", "group": { "kind": "*Build", "isDefault": true } },
			{ "name": "deploy:staging", "group": { "kind": "*CI", "isDefault": false } },
			{ "name": "deploy:production", "group": { "kind": "*CI", "isDefault": false } },
			{ "name": "lint:all" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": true, "showHidden": false },
	"nodeConfig": { "useFolderIcon": true, "defaultIconName": "play", "tintLabel": false },

}