// ══════════════════════════════════════════════════════════════════════════════
// STRESS SKETCH: "Кувалда"
// ══════════════════════════════════════════════════════════════════════════════
//
// 5 scopes, 200+ задач, 20+ favorites (включая broken/dead/hidden refs).
//
// Нагрузка:
//  • Multi-root workspace: backend, frontend, mobile, infra, shared
//  • useGroupKind: true — build/test/deploy секции (backend, infra)
//  • Глубина до 8 уровней (mobile:e2e:detox:android:suite:critical:smoke:run)
//  • Path compression SMART — длинные однодетные цепочки в Pinned
//  • Все комбинации флагов, включая невозможные
//  • Массовые task-as-group (proto:codegen, k8s:deploy, etc.)
//  • Hidden groups с видимыми детьми на 2+ уровнях
//  • Коллизии имён: "build", "test", "lint", "run" повторяются в каждом scope
//  • Иконки: 20+ уникальных id, blank, отсутствие (fallback на defaultIconName)
//  • tintLabel: true — все цвета propagate на label
//  • Favorites cross-scope, dead refs, hidden refs, task-as-group refs
//  • Задачи с ":" в имени сегмента (edge case для парсера?)
//    — нет, separator = ":", так что это просто глубокая вложенность
//
{
	"scopes": {
		"backend":  "/workspace/backend/.vscode/tasks.json",
		"frontend": "/workspace/frontend/.vscode/tasks.json",
		"mobile":   "/workspace/mobile/.vscode/tasks.json",
		"infra":    "/workspace/infra/.vscode/tasks.json",
		"shared":   "/workspace/shared/.vscode/tasks.json"
	},

	"tasks": {

		// ═══════════════════════════════════════════════════════════
		// BACKEND — ~55 задач
		// useGroupKind: задачи распределяются по build / test / deploy
		// ═══════════════════════════════════════════════════════════
		"/workspace/backend/.vscode/tasks.json": [

			// ── build ────────────────────────────────────────────
			{ "name": "core:compile", "group": { "kind": "build", "isDefault": true }, "icon": { "id": "package", "color": "terminal.ansiGreen" } },
			{ "name": "core:compile:watch", "group": { "kind": "build" }, "isBackground": true, "icon": { "id": "eye", "color": "terminal.ansiGreen" } },
			{ "name": "core:compile:release", "group": { "kind": "build" }, "icon": { "id": "package", "color": "terminal.ansiYellow" } },
			{ "name": "docker:build", "group": { "kind": "build" }, "icon": { "id": "server", "color": "terminal.ansiBlue" } },
			{ "name": "docker:push", "group": { "kind": "build" }, "icon": { "id": "cloud-upload", "color": "terminal.ansiBlue" } },
			{ "name": "docker:build:multi-arch", "group": { "kind": "build" }, "icon": { "id": "server", "color": "terminal.ansiMagenta" } },

			// ── test ─────────────────────────────────────────────
			{ "name": "test:unit", "group": { "kind": "test" }, "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:unit:watch", "group": { "kind": "test" }, "isBackground": true, "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:unit:coverage", "group": { "kind": "test" }, "icon": { "id": "graph", "color": "terminal.ansiCyan" } },
			{ "name": "test:integration:api", "group": { "kind": "test" }, "icon": { "id": "beaker", "color": "terminal.ansiGreen" } },
			{ "name": "test:integration:db", "group": { "kind": "test" }, "icon": { "id": "beaker", "color": "terminal.ansiGreen" } },
			{ "name": "test:integration:redis", "group": { "kind": "test" }, "icon": { "id": "beaker", "color": "terminal.ansiRed" } },
			{ "name": "test:integration:queue", "group": { "kind": "test" }, "icon": { "id": "beaker", "color": "terminal.ansiMagenta" } },
			{ "name": "test:e2e:smoke", "group": { "kind": "test" }, "isBackground": true, "icon": { "id": "flame", "color": "terminal.ansiRed" } },
			{ "name": "test:e2e:full", "group": { "kind": "test" }, "icon": { "id": "flame", "color": "terminal.ansiRed" } },
			{ "name": "test:mutation", "group": { "kind": "test" }, "icon": { "id": "bug", "color": "terminal.ansiMagenta" } },

			// ── deploy ───────────────────────────────────────────
			{ "name": "deploy:staging", "group": { "kind": "deploy" }, "icon": { "id": "cloud-upload", "color": "terminal.ansiYellow" } },
			{ "name": "deploy:prod", "group": { "kind": "deploy" }, "hidden": true, "icon": { "id": "cloud-upload", "color": "terminal.ansiRed" } },
			{ "name": "deploy:canary", "group": { "kind": "deploy" }, "icon": { "id": "cloud-upload", "color": "terminal.ansiCyan" } },

			// ── ungrouped ────────────────────────────────────────
			{ "name": "db:migrate:up", "icon": { "id": "database", "color": "terminal.ansiCyan" } },
			{ "name": "db:migrate:down", "icon": { "id": "database", "color": "terminal.ansiCyan" } },
			{ "name": "db:migrate:create", "icon": { "id": "database", "color": "terminal.ansiGreen" } },
			{ "name": "db:migrate:status", "icon": { "id": "database", "color": "terminal.ansiYellow" } },
			{ "name": "db:seed:dev", "icon": { "id": "database", "color": "terminal.ansiMagenta" } },
			{ "name": "db:seed:test", "icon": { "id": "database", "color": "terminal.ansiMagenta" } },
			{ "name": "db:seed:reset", "icon": { "id": "database", "color": "terminal.ansiRed" } },
			{ "name": "api:generate:openapi", "icon": { "id": "file-code", "color": "terminal.ansiCyan" } },
			{ "name": "api:generate:client", "icon": { "id": "file-code", "color": "terminal.ansiCyan" } },
			{ "name": "api:validate:schema" },
			{ "name": "server:dev", "isBackground": true, "icon": { "id": "play", "color": "terminal.ansiGreen" } },
			{ "name": "server:start", "icon": { "id": "play", "color": "terminal.ansiGreen" } },
			{ "name": "server:debug", "isBackground": true, "icon": { "id": "debug", "color": "terminal.ansiYellow" } },
			{ "name": "server:inspect", "isBackground": true, "icon": { "id": "debug", "color": "terminal.ansiMagenta" } },
			{ "name": "queue:worker:start", "isBackground": true, "icon": { "id": "play", "color": "terminal.ansiBlue" } },
			{ "name": "queue:worker:restart", "icon": { "id": "refresh", "color": "terminal.ansiBlue" } },
			{ "name": "queue:scheduler:start", "isBackground": true, "icon": { "id": "clock", "color": "terminal.ansiBlue" } },
			{ "name": "cache:flush", "icon": { "id": "trash", "color": "terminal.ansiRed" } },
			{ "name": "cache:warmup", "icon": { "id": "flame", "color": "terminal.ansiYellow" } },
			{ "name": "cache:stats" },
			{ "name": "lint:eslint", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			{ "name": "lint:prettier", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			{ "name": "lint:typecheck", "icon": { "id": "search", "color": "terminal.ansiYellow" } },
			{ "name": "lint:deadcode", "icon": { "id": "search", "color": "terminal.ansiRed" } },
			// task-as-group: "lint" is a prefix AND we want it runnable
			{ "name": "lint", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			// невозможная комбинация флагов
			{ "name": "nuke-everything", "hidden": true, "isBackground": true, "group": { "kind": "deploy", "isDefault": true }, "icon": { "id": "flame", "color": "terminal.ansiRed" } },
			// blank icon
			{ "name": "secret:internal:do-not-touch", "icon": { "id": "blank" } },
			// no icon — fallback
			{ "name": "misc:healthcheck" },
			{ "name": "misc:version" },
			{ "name": "misc:env:print" },
			{ "name": "misc:env:validate" }
		],

		// ═══════════════════════════════════════════════════════════
		// FRONTEND — ~50 задач
		// Без useGroupKind — чистая иерархия по сегментам.
		// ═══════════════════════════════════════════════════════════
		"/workspace/frontend/.vscode/tasks.json": [

			// ── ui:components — массив одинаковых leaf-имён ──────
			{ "name": "ui:components:Button:build" },
			{ "name": "ui:components:Button:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "ui:components:Button:storybook", "isBackground": true, "icon": { "id": "book", "color": "terminal.ansiMagenta" } },
			{ "name": "ui:components:Modal:build" },
			{ "name": "ui:components:Modal:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "ui:components:Modal:storybook", "isBackground": true, "icon": { "id": "book", "color": "terminal.ansiMagenta" } },
			{ "name": "ui:components:Table:build" },
			{ "name": "ui:components:Table:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "ui:components:Table:storybook", "isBackground": true, "icon": { "id": "book", "color": "terminal.ansiMagenta" } },
			{ "name": "ui:components:Table:perf", "icon": { "id": "dashboard", "color": "terminal.ansiCyan" } },
			{ "name": "ui:components:Form:build" },
			{ "name": "ui:components:Form:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "ui:components:Form:storybook", "isBackground": true, "icon": { "id": "book", "color": "terminal.ansiMagenta" } },
			{ "name": "ui:components:Form:validate", "icon": { "id": "check", "color": "terminal.ansiGreen" } },
			{ "name": "ui:components:Nav:build" },
			{ "name": "ui:components:Nav:test" },
			{ "name": "ui:components:Sidebar:build" },
			{ "name": "ui:components:Sidebar:test" },
			{ "name": "ui:components:Toast:build" },
			{ "name": "ui:components:Toast:test" },

			// ── ui:design-system ─────────────────────────────────
			{ "name": "ui:design-system:build", "icon": { "id": "paintcan", "color": "terminal.ansiMagenta" } },
			{ "name": "ui:design-system:tokens", "icon": { "id": "symbol-color", "color": "terminal.ansiMagenta" } },
			{ "name": "ui:design-system:icons", "icon": { "id": "symbol-misc", "color": "terminal.ansiCyan" } },

			// ── app ──────────────────────────────────────────────
			{ "name": "app:dev", "isBackground": true, "icon": { "id": "play", "color": "terminal.ansiGreen" } },
			{ "name": "app:build", "icon": { "id": "package", "color": "terminal.ansiGreen" } },
			{ "name": "app:build:analyze", "icon": { "id": "graph", "color": "terminal.ansiYellow" } },
			{ "name": "app:preview", "icon": { "id": "browser" } },
			{ "name": "app:ssr", "icon": { "id": "server", "color": "terminal.ansiBlue" } },

			// ── test ─────────────────────────────────────────────
			{ "name": "test:unit", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:unit:watch", "isBackground": true, "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:integration" },
			{ "name": "test:e2e:cypress:run" },
			{ "name": "test:e2e:cypress:open", "isBackground": true },
			{ "name": "test:e2e:playwright" },
			{ "name": "test:visual:snapshot" },
			{ "name": "test:visual:approve", "icon": { "id": "check", "color": "terminal.ansiGreen" } },

			// ── lint ─────────────────────────────────────────────
			{ "name": "lint:eslint", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			{ "name": "lint:stylelint", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			{ "name": "lint:typecheck", "icon": { "id": "search", "color": "terminal.ansiYellow" } },

			// ── perf ─────────────────────────────────────────────
			{ "name": "perf:lighthouse", "icon": { "id": "dashboard", "color": "terminal.ansiCyan" } },
			{ "name": "perf:bundle-analyze", "icon": { "id": "graph", "color": "terminal.ansiYellow" } },
			{ "name": "perf:web-vitals" },

			// ── i18n ─────────────────────────────────────────────
			{ "name": "i18n:extract" },
			{ "name": "i18n:compile" },
			{ "name": "i18n:validate" },

			// ── storybook ────────────────────────────────────────
			{ "name": "storybook:dev", "isBackground": true, "icon": { "id": "book", "color": "terminal.ansiMagenta" } },
			{ "name": "storybook:build", "icon": { "id": "book", "color": "terminal.ansiMagenta" } },
			{ "name": "storybook:deploy", "icon": { "id": "cloud-upload", "color": "terminal.ansiMagenta" } },

			// hidden
			{ "name": "legacy:webpack:build", "hidden": true },
			{ "name": "legacy:webpack:serve", "hidden": true, "isBackground": true }
		],

		// ═══════════════════════════════════════════════════════════
		// MOBILE — ~45 задач
		// Глубина до 8 уровней. Коллизии "build", "run" с другими scope'ами.
		// ═══════════════════════════════════════════════════════════
		"/workspace/mobile/.vscode/tasks.json": [

			// ── android ──────────────────────────────────────────
			{ "name": "android:build:debug", "icon": { "id": "device-mobile", "color": "terminal.ansiGreen" } },
			{ "name": "android:build:release", "icon": { "id": "device-mobile", "color": "terminal.ansiYellow" } },
			{ "name": "android:build:release:signed", "icon": { "id": "device-mobile", "color": "terminal.ansiRed" } },
			{ "name": "android:run", "isBackground": true, "icon": { "id": "play", "color": "terminal.ansiGreen" } },
			{ "name": "android:clean" },
			{ "name": "android:bundle", "icon": { "id": "package", "color": "terminal.ansiGreen" } },
			{ "name": "android:aab:upload", "icon": { "id": "cloud-upload", "color": "terminal.ansiBlue" } },

			// ── ios ──────────────────────────────────────────────
			{ "name": "ios:build:debug", "icon": { "id": "device-mobile", "color": "terminal.ansiGreen" } },
			{ "name": "ios:build:release", "icon": { "id": "device-mobile", "color": "terminal.ansiYellow" } },
			{ "name": "ios:run", "isBackground": true, "icon": { "id": "play", "color": "terminal.ansiGreen" } },
			{ "name": "ios:clean" },
			{ "name": "ios:pod-install", "icon": { "id": "package", "color": "terminal.ansiRed" } },
			{ "name": "ios:archive", "icon": { "id": "package", "color": "terminal.ansiBlue" } },
			{ "name": "ios:archive:upload", "icon": { "id": "cloud-upload", "color": "terminal.ansiBlue" } },

			// ── test — ГЛУБИНА 8 ─────────────────────────────────
			{ "name": "test:unit", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:unit:watch", "isBackground": true, "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:integration" },
			{ "name": "test:e2e:detox:android:suite:critical:smoke:run", "icon": { "id": "flame", "color": "terminal.ansiRed" } },
			{ "name": "test:e2e:detox:android:suite:critical:smoke:record", "icon": { "id": "record", "color": "terminal.ansiRed" } },
			{ "name": "test:e2e:detox:android:suite:regression:full", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "test:e2e:detox:android:suite:regression:flaky-retry" },
			{ "name": "test:e2e:detox:ios:suite:critical:smoke:run", "icon": { "id": "flame", "color": "terminal.ansiRed" } },
			{ "name": "test:e2e:detox:ios:suite:regression:full" },
			{ "name": "test:snapshot:update" },
			{ "name": "test:snapshot:verify" },

			// ── codegen ──────────────────────────────────────────
			{ "name": "codegen:assets", "icon": { "id": "file-media", "color": "terminal.ansiCyan" } },
			{ "name": "codegen:icons", "icon": { "id": "symbol-misc", "color": "terminal.ansiCyan" } },
			{ "name": "codegen:fonts" },
			{ "name": "codegen:graphql", "icon": { "id": "file-code", "color": "terminal.ansiMagenta" } },
			{ "name": "codegen:graphql:schema", "icon": { "id": "file-code", "color": "terminal.ansiMagenta" } },
			{ "name": "codegen:graphql:types", "icon": { "id": "file-code", "color": "terminal.ansiMagenta" } },

			// ── lint ─────────────────────────────────────────────
			{ "name": "lint:eslint", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			{ "name": "lint:kotlin", "icon": { "id": "search", "color": "terminal.ansiBlue" } },
			{ "name": "lint:swift", "icon": { "id": "search", "color": "terminal.ansiRed" } },
