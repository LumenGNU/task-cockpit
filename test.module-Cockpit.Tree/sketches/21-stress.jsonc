			{ "name": "dns:update", "hidden": true },

			// ── ci (task-as-group) ───────────────────────────────
			{ "name": "ci", "icon": { "id": "gear", "color": "terminal.ansiBlue" } },
			{ "name": "ci:lint" },
			{ "name": "ci:test" },
			{ "name": "ci:build" },
			{ "name": "ci:deploy", "hidden": true },
			{ "name": "ci:notify", "isBackground": true, "icon": { "id": "bell", "color": "terminal.ansiBlue" } }
		],

		// ═══════════════════════════════════════════════════════════
		// SHARED — ~35 задач
		// Libs, protos, docs. Максимум task-as-group.
		// ═══════════════════════════════════════════════════════════
		"/workspace/shared/.vscode/tasks.json": [

			// ── proto (task-as-group на 2 уровнях) ───────────────
			{ "name": "proto:codegen", "icon": { "id": "zap", "color": "terminal.ansiYellow" } },
			{ "name": "proto:codegen:go" },
			{ "name": "proto:codegen:ts" },
			{ "name": "proto:codegen:python" },
			{ "name": "proto:codegen:swift" },
			{ "name": "proto:codegen:kotlin" },
			{ "name": "proto:lint", "icon": { "id": "search", "color": "terminal.ansiMagenta" } },
			{ "name": "proto:breaking-check", "icon": { "id": "warning", "color": "terminal.ansiRed" } },
			// "proto" itself is also a task-as-group
			{ "name": "proto", "icon": { "id": "file-code", "color": "terminal.ansiCyan" } },

			// ── lib ──────────────────────────────────────────────
			{ "name": "lib:utils:build" },
			{ "name": "lib:utils:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "lib:logger:build" },
			{ "name": "lib:logger:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "lib:config:build" },
			{ "name": "lib:config:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },
			{ "name": "lib:config:validate", "icon": { "id": "check", "color": "terminal.ansiGreen" } },
			{ "name": "lib:auth:build" },
			{ "name": "lib:auth:test", "icon": { "id": "beaker", "color": "terminal.ansiYellow" } },

			// ── docs ─────────────────────────────────────────────
			{ "name": "docs:generate", "icon": { "id": "notebook", "color": "terminal.ansiCyan" } },
			{ "name": "docs:serve", "isBackground": true, "icon": { "id": "browser", "color": "terminal.ansiCyan" } },
			{ "name": "docs:deploy", "icon": { "id": "cloud-upload", "color": "terminal.ansiCyan" } },
			{ "name": "docs:validate-links", "icon": { "id": "link", "color": "terminal.ansiYellow" } },
			{ "name": "docs:spellcheck" },

			// ── ci:pipeline ──────────────────────────────────────
			{ "name": "ci:pipeline:validate" },
			{ "name": "ci:pipeline:build-all", "group": { "kind": "build", "isDefault": true }, "icon": { "id": "package", "color": "terminal.ansiGreen" } },
			{ "name": "ci:pipeline:notify", "isBackground": true, "icon": { "id": "bell", "color": "terminal.ansiBlue" } },
			{ "name": "ci:pipeline:cleanup", "icon": { "id": "trash", "color": "terminal.ansiRed" } },

			// ── deps ─────────────────────────────────────────────
			{ "name": "deps:audit", "icon": { "id": "shield", "color": "terminal.ansiYellow" } },
			{ "name": "deps:update" },
			{ "name": "deps:licenses", "icon": { "id": "law", "color": "terminal.ansiCyan" } },
			{ "name": "deps:graph", "icon": { "id": "graph", "color": "terminal.ansiMagenta" } },

			// hidden group + visible children
			{ "name": "internal:legacy:v1-compat", "hidden": true },
			{ "name": "internal:legacy:v1-compat:shim-a" },
			{ "name": "internal:legacy:v1-compat:shim-b" },
			{ "name": "internal:legacy:v2-migration" }
		]
	},

	"treeConfig": {
		"segmentSeparator": ":",
		"useGroupKind": true,
		"showHidden": false
	},
	"nodeConfig": {
		"useFolderIcon": false,
		"defaultIconName": "tools",
		"tintLabel": true
	},

	"favorites": {
		"visibility": "AUTO",
		"compressionBehavior": "SMART",
		"refs": [
			// ── cross-scope: backend ─────────────────────────────
			{ "folder": "backend",  "label": "deploy:prod" },                                    // hidden task → visible in pinned
			{ "folder": "backend",  "label": "db:migrate:up" },                                  // regular deep
			{ "folder": "backend",  "label": "lint" },                                            // task-as-group
			{ "folder": "backend",  "label": "server:dev" },                                      // isBackground
			{ "folder": "backend",  "label": "nuke-everything" },                                 // hidden + all flags

			// ── cross-scope: frontend ────────────────────────────
			{ "folder": "frontend", "label": "ui:components:Button:test" },                       // deep, 4 levels
			{ "folder": "frontend", "label": "ui:components:Table:perf" },                        // deep, 4 levels
			{ "folder": "frontend", "label": "app:dev" },                                         // isBackground
			{ "folder": "frontend", "label": "legacy:webpack:build" },                            // hidden, dead?

			// ── cross-scope: mobile ──────────────────────────────
			{ "folder": "mobile",   "label": "test:e2e:detox:android:suite:critical:smoke:run" }, // 8 LEVELS DEEP
			{ "folder": "mobile",   "label": "deploy" },                                          // task-as-group
			{ "folder": "mobile",   "label": "deploy:prod:android" },                             // hidden
			{ "folder": "mobile",   "label": "metro:start" },                                     // isBackground

			// ── cross-scope: infra ───────────────────────────────
			{ "folder": "infra",    "label": "terraform:apply:auto-approve" },                    // hidden
			{ "folder": "infra",    "label": "k8s:deploy:prod" },                                 // hidden
			{ "folder": "infra",    "label": "ci" },                                              // task-as-group
			{ "folder": "infra",    "label": "secrets:rotate" },                                   // hidden

			// ── cross-scope: shared ──────────────────────────────
			{ "folder": "shared",   "label": "proto:codegen" },                                   // task-as-group, 2-level
			{ "folder": "shared",   "label": "proto" },                                           // task-as-group, parent
			{ "folder": "shared",   "label": "internal:legacy:v1-compat:shim-a" }                 // child of hidden group
		],
		"stales": [
		    // ── DEAD REFS ────────────────────────────────────────
			{ "folder": "NONEXISTENT", "label": "phantom:task" },                                 // folder не существует
			{ "folder": "backend",     "label": "this:task:does:not:exist" },                     // folder есть, задачи нет
			{ "folder": "shared",      "label": "proto:codegen:rust" }                            // folder есть, leaf нет
		
		]
	}
}

// ══════════════════════════════════════════════════════════════════════════════
// КАТАЛОГ EDGE CASES В ЭТОМ СКЕТЧЕ
// ══════════════════════════════════════════════════════════════════════════════
//
// 1.  ГЛУБИНА 8: mobile → test:e2e:detox:android:suite:critical:smoke:run
//     + Favorite на неё → SMART compression в Pinned:
//     test › e2e › detox › android › suite › critical › smoke › run (*)
//
// 2.  TASK-AS-GROUP (5 штук):
//     - backend/lint (задача + дети lint:eslint, lint:prettier, ...)
//     - mobile/deploy (задача + дети deploy:staging:android, ...)
//     - infra/ci (задача + дети ci:lint, ci:test, ...)
//     - shared/proto (задача + дети proto:codegen, proto:lint, ...)
//     - shared/proto:codegen (задача + дети codegen:go, codegen:ts, ...)
//     → двухуровневый task-as-group: proto → codegen → children
//
// 3.  HIDDEN GROUP, VISIBLE CHILDREN (3 случая):
//     - shared/internal:legacy:v1-compat (hidden) → shim-a, shim-b видимы
//     - frontend/legacy:webpack (оба hidden) → оба невидимы, dead branch
//     - backend/deploy:prod (hidden) → нет детей, но есть sibling deploy:staging
//
// 4.  useGroupKind КОНФЛИКТ:
//     backend и infra имеют group.kind, остальные — нет.
//     "ci:build" в infra с group.kind vs "ci:pipeline:build-all" в shared с group.kind.
//     Рендерер должен обрабатывать kind-секции per-scope.
//
// 5.  КОЛЛИЗИЯ ИМЁН (по leaf):
//     "build": Button:build, Modal:build, Table:build, Form:build, app:build,
//              android:build:*, ios:build:*, docker:build:*, ci:build, ...
//     "test":  аналогично, 10+ одинаковых leaf'ов
//     "lint":  5 scope'ов × свои lint:* задачи + task-as-group "lint" в backend
//     "run":   detox:...:run, db:migrate:run — разные scope'ы
//
// 6.  FAVORITES (24 штуки):
//     - 5 на hidden задачи → видимы в Pinned, невидимы в дереве
//     - 3 на task-as-group → должны быть запускаемыми в Pinned
//     - 1 на задачу глубиной 8 → проверка SMART compression
//     - 3 dead refs: несуществующий folder, несуществующая задача,
//       несуществующий leaf в существующем prefix
//     - 1 на child of hidden group → shim-a видна в Pinned, parent hidden
//
// 7.  BLANK ICON: backend/secret:internal:do-not-touch
//     NO ICON (fallback): ~15 задач без icon → defaultIconName "tools"
//
// 8.  ВСЕ ФЛАГИ ОДНОВРЕМЕННО: backend/nuke-everything
//     hidden + isBackground + isDefault + group.kind="deploy"
//     + Favorite на неё → видна в Pinned, невидима в дереве
//
// 9.  isBackground МАССОВО: 15+ задач с isBackground
//     server:dev, metro:start, k8s:logs, docker:compose:up, ...
//     Проверка что background badge не ломает layout при масштабе
//
// 10. tintLabel: true + 20+ уникальных иконок
//     Цветовая каша в дереве — визуальный stress test для рендерера
//
// Итого: 225 задач, 5 scope'ов, 24 favorites (3 dead)