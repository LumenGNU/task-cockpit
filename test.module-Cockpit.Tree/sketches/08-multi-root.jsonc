// Multi-root workspace: несколько папок.
// Проверяет:
// - отображение заголовков папок (в multi-root они появляются)
// - изоляцию задач по папкам
// - задачи с одинаковым именем ветки "build" в разных scope — не конфликтуют
//
// Ожидаемое дерево:
//   frontend
//     build
//       dev
//       prod
//     lint
//   backend
//     build
//       server
//       worker
//     migrate
//   shared
//     typecheck
{
	"scopes": {
		// TODO а где сама workspace???
		"frontend": "/workspace/frontend/.vscode/tasks.json",
		"backend": "/workspace/backend/.vscode/tasks.json",
		"shared": "/workspace/shared/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/frontend/.vscode/tasks.json": [
			{ "name": "build:dev" },
			{ "name": "build:prod" },
			{ "name": "lint" }
		],
		"/workspace/backend/.vscode/tasks.json": [
			{ "name": "build:server" },
			{ "name": "build:worker" },
			{ "name": "migrate" }
		],
		"/workspace/shared/.vscode/tasks.json": [
			{ "name": "typecheck" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}