
// Флаги задач отображаются в description
{
	"scopes": {
		"app": "/workspace/app/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/app/.vscode/tasks.json": [
			{ "name": "hidden", "hidden": true },
			{ "name": "default", "group": { "kind": "grp", "isDefault": true } },
			{ "name": "background", "isBackground": true },
			{ "name": "default-background", "isBackground": true, "group": { "kind": "grp", "isDefault": true } },
			{ "name": "all-flags",  "hidden": true, "group": { "kind": "grp", "isDefault": true }, "isBackground": true },
			{ "name": "NO-flags" }
		]
	},
	"treeConfig": { "segmentSeparator": "", "useGroupKind": false, "showHidden": true },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}