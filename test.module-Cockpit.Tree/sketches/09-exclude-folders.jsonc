// Multi-root с исключением папок.
// Проверяет: excludeFolders — папка "backend" полностью скрыта,
// её задачи не попадают в дерево.
//
// Ожидаемое дерево (backend исключён):
//
// ─ [project (workspace)]
//   └─ <EMPTY>
// ─ [frontend]
//   ├─ build
//   └─ test
// ─ [docs]
//   └─ generate
{
	"scopes": {
		"project (workspace)": "/workspace/project.code-workspace",
		"frontend": "/workspace/frontend/.vscode/tasks.json",
		"backend": "/workspace/backend/.vscode/tasks.json",
		"docs": "/workspace/docs/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/project.code-workspace": [],
		"/workspace/frontend/.vscode/tasks.json": [
			{ "name": "build" },
			{ "name": "test" }
		],
		// (не видно в дереве)
		"/workspace/backend/.vscode/tasks.json": [
			{ "name": "serve" },
			{ "name": "migrate" }
		],
		"/workspace/docs/.vscode/tasks.json": [
			{ "name": "generate" }
		]
	},
	"treeConfig": { "segmentSeparator": "", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false },
	"excludeFolders": ["backend"]
}