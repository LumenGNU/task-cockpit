// Скрытые задачи и взаимодействие с showHidden.
// Проверяет:
// 1) hidden задачи не отображаются при showHidden: false
// 2) hidden лист внутри ветки — ветка остаётся, лист исчезает
// 3) плоский hidden — просто отсутствует
//
// При showHidden: false ожидается:
//   build
//     dev
//     prod         ← видимый
//                  ← "build:hidden" скрыт
//   test
//     unit
//     e2e
//   deploy:canary  ← видимый лист
//                  ← "hidden-tool" скрыт
//                  ← "hidden > tool" скрыт, не "высящей" группы hidden
//
// Для проверки showHidden: true — дублировать файл и переключить флаг.
{
	"scopes": {
		"app": "/workspace/app/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/app/.vscode/tasks.json": [
			{ "name": "build:dev" },
			{ "name": "build:prod" },
			{ "name": "build:hidden", "hidden": true },
			{ "name": "test:unit" },
			{ "name": "test:e2e" },
			{ "name": "deploy:canary" },
			{ "name": "hidden-tool", "hidden": true },
			{ "name": "hidden:tool", "hidden": true }
		]
	},
	"treeConfig": { "showHidden": false, "segmentSeparator": ":", "useGroupKind": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}