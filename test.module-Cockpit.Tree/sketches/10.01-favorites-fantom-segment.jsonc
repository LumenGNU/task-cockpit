{
    "scopes": {
        "app": "/workspace/app/.vscode/tasks.json"
    },
    "tasks": {
        "/workspace/app/.vscode/tasks.json": [
            { "name": "aaa:bbb:ccc:ddd:task1" },
            { "name": "aaa:bbb:ccc:task2" }
        ]
    },
    "treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
    "nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false },
    "favorites": {
        "visibility": "AUTO",
        "compressionBehavior": "NORMAL", // NORMAL | SMART
        "refs": [
            // BUG: (решено) Section::buildCompressedPath
            // Без guard'а reverseAndJoin() породит фантомный пустой сегмент.
            { "folder": "app", "label": "aaa:bbb:ccc:ddd:task1" },
            { "folder": "app", "label": "aaa:bbb:ccc:task2" }
            // --- разный порядок, для проверки ---
            // { "folder": "app", "label": "aaa:bbb:ccc:task2" },
            // { "folder": "app", "label": "aaa:bbb:ccc:ddd:task1" }
        ]
    }
}