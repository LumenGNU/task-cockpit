// Favorites в multi-root: задачи из разных папок + битая ссылка.
// Проверяет:
// - favorites из разных scope
// - broken favorite ("deploy" не существует) → virtual broken node
// - порядок favorites сохраняется независимо от scope
//
// Favorites:
//   1. frontend / build:dev     ← валидный
//   2. backend / serve          ← валидный
//   3. frontend / deploy        ← БИТАЯ ССЫЛКА
//   4. backend / migrate        ← валидный
{
	"scopes": {
		"frontend": "/workspace/frontend/.vscode/tasks.json",
		"backend": "/workspace/backend/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/frontend/.vscode/tasks.json": [
			{ "name": "build:dev" },
			{ "name": "build:prod" },
			{ "name": "lint" }
		],
		"/workspace/backend/.vscode/tasks.json": [
			{ "name": "serve" },
			{ "name": "migrate" },
			{ "name": "seed" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false },
	"favorites": {
		"refs": [
			{ "folder": "frontend", "label": "build:dev" },
			{ "folder": "backend", "label": "serve" },
			{ "folder": "backend", "label": "migrate" }
		],
		"stales": [
			// Отображается как "сломанная", в верху списка закрепленных
			{ "folder": "_frontend", "label": "deploy" }
		]
	}
}