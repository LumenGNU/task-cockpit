// Порядок веток: позиция определяется первым упоминанием в файле.
// Проверяет ключевое поведение из README:
// "A branch appears at the position of its earliest occurrence"
//
// Задачи специально перемешаны:
//   1. "deploy:canary"     → ветка "deploy" появляется 1-й
//   2. "build:prod"        → ветка "build" появляется 2-й
//   3. "test:e2e"          → ветка "test" появляется 3-й
//   4-7: добавляются в существующие ветки
//
// Ожидаемый порядок верхнего уровня: deploy, build, test
// Внутри каждой ветки — порядок из файла:
//   deploy: canary, production
//   build: prod, dev, staging
//   test: e2e, unit
{
	"scopes": {
		"app": "/workspace/app/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/app/.vscode/tasks.json": [
			{ "name": "deploy:canary" },
			{ "name": "build:prod" },
			{ "name": "test:e2e" },
			{ "name": "build:dev" },
			{ "name": "deploy:production" },
			{ "name": "test:unit" },
			{ "name": "build:staging" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}