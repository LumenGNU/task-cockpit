// Пограничные случаи: пустые состояния.
// Проверяет:
// 1) Папка "empty" — без задач. Отображается ли пустая папка?
// 2) Папка "one-task" — единственная задача. Минимальный непустой случай.
// 3) Папка "all-hidden" — все задачи скрыты при showHidden: false.
//    По сути пустая, но технически задачи есть.
//
//
// ─ [project (WS)]
//   └─ <EMPTY>
// ─ [empty]
//   └─ <EMPTY>
// ─ [one-task]
//   └─ the-only-task
// ─ [all-hidden]
//   └─ <EMPTY>
// 
// Вопросы:
// - Показываются ли пустые scope-заголовки?
// - Есть ли empty-marker в таких случаях?
{
	"scopes": {
		"project (WS)": "/workspace/empty.code-workspace",
		"empty": "/workspace/empty/.vscode/tasks.json",
		"one-task": "/workspace/one-task/.vscode/tasks.json",
		"all-hidden": "/workspace/all-hidden/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/empty.code-workspace": [],
		"/workspace/empty/.vscode/tasks.json": [],
		"/workspace/one-task/.vscode/tasks.json": [
			{ "name": "the-only-task" }
		],
		"/workspace/all-hidden/.vscode/tasks.json": [
			{ "name": "ghost-1", "hidden": true },
			{ "name": "ghost-2", "hidden": true }
		]
	},
	"treeConfig": { "segmentSeparator": "", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}