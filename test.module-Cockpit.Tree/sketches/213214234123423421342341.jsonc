// Плоский список без иерархии.
// Базовый случай: все задачи на одном уровне, separator отключён.
// Проверяет: сохранение порядка из файла, рендеринг без вложенности.
{
	"sketch": {
		"scopes": {
			"app": "app/.vscode/tasks.json"
		},
		"tasks": {
			"app": [
				{ "name": "CCC" },
				{ "name": "EEE" },
				{ "name": "BBB" },
				{ "name": "FFF" },
				{ "name": "AAA" }
			]
		},
		"treeConfig": {
			"segmentSeparator": "",
			"useGroupKind": false,
			"showHidden": false
		},
		"nodeConfig": {
			"useFolderIcon": false,
			"defaultIconName": "tools",
			"tintLabel": false
		}
	},
	"asciiTree": [
		"[F[ app ]] ",
		" ├─ ▶ CCC  ",
		" ├─ ▶ EEE  ",
		" ├─ ▶ BBB  ",
		" ├─ ▶ FFF  ",
		" └─ ▶ AAA  "
	]
}