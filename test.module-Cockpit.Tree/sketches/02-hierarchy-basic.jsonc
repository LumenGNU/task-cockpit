// Базовая иерархия через separator.
// Проверяет: разбивку label на сегменты, создание implicit intermediate nodes,
// правильное вложение (build → dev, build → prod), листовые и групповые узлы.
// Ожидаемое дерево:
//
// ─ [frontend]
//   ├─ build 
//   │  ├─ dev
//   │  └─ prod
//   ├─ test 
//   │  ├─ unit
//   │  └─ e2e
//   └─ lint  ← плоский лист, без вложенности
{
	"scopes": {
		"frontend": "/workspace/frontend/.vscode/tasks.json"
	},
	"tasks": {
		"/workspace/frontend/.vscode/tasks.json": [
			{ "name": "build:dev" },
			{ "name": "build:prod" },
			{ "name": "test:unit" },
			{ "name": "test:e2e" },
			{ "name": "lint" }
		]
	},
	"treeConfig": { "segmentSeparator": ":", "useGroupKind": false, "showHidden": false },
	"nodeConfig": { "useFolderIcon": false, "defaultIconName": "tools", "tintLabel": false }
}