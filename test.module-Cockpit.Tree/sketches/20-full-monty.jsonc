// ══════════════════════════════════════════════════════════════════════
// STRESS SKETCH: "The Full Monty"
// ══════════════════════════════════════════════════════════════════════
//
// Нагружает одновременно:
//  • Multi-root workspace (3 scope'а)
//  • Глубокая иерархия (до 7 уровней)
//  • Все комбинации флагов (hidden, isBackground, group.isDefault)
//  • useGroupKind: true — задачи с group.kind группируются по kind
//  • Кастомные иконки, цвета, tintLabel, blank, defaultIconName
//  • Favorites cross-scope — ссылки на задачи из разных folders
//  • Task-as-group (задача является и группой для детей)
//  • Hidden group + видимые дети
//  • Path compression (SMART) — однодетные узлы схлопываются
//  • Одинаковые имена задач в разных scope'ах
//  • Пустые промежуточные сегменты (edge case)
//  • Favorite на hidden задачу (broken ref vs visible?)
//  • Favorite на задачу из несуществующего folder (dead ref)
//
// Ожидаемое дерево (showHidden: false, SMART compression):
//
// ─ [Pinned]
//   ├─ «backend»
//   │  ├─ infra › k8s › deploy-prod (*)          ← deep path, hidden task, visible in pinned
//   │  └─ db › migrate › run (*)                  ← regular favorite
//   ├─ «frontend»
//   │  └─ ui › components › Button › test (*)     ← cross-scope fav
//   ├─ «shared»
//   │  └─ proto › codegen (*)                     ← fav on task-as-group
//   └─ «DEAD_FOLDER»
//      └─ ghost:task (*)                          ← dead ref (folder не существует)
//
// ─ [backend]  (group kinds: build, test, deploy, none)
//   ├── «build»                                   ← group kind section
//   │  ├─ core › compile (*)                      ← isDefault
//   │  └─ core › compile:watch (*)                ← isBackground + isDefault
//   ├── «test»
//   │  ├─ unit (*)
//   │  ├─ integration › api (*)
//   │  ├─ integration › db (*)
//   │  └─ e2e › smoke (*)                         ← isBackground
//   ├── «deploy»
//   │  └─ infra
//   │     └─ k8s
//   │        ├─ deploy-staging (*)
//   │        └─ deploy-prod (*)                   ← hidden (не видна, но implicit group жив)
//   └── «(ungrouped)»
//   │  ├─ db › migrate
//   │  │  ├─ run (*)
//   │  │  ├─ rollback (*)
//   │  │  └─ seed (*)
//   │  ├─ lint (*)
//   │  └─ all-flags (*)                           ← hidden+isDefault+isBackground (НЕВИДИМА)
//
// ─ [frontend]
//   ├─ ui › components
//   │  ├─ Button
//   │  │  ├─ build (*)
//   │  │  ├─ test (*)
//   │  │  └─ storybook (*)                        ← isBackground
//   │  ├─ Modal › build (*)
//   │  └─ Table
//   │     ├─ build (*)
//   │     └─ test (*)
//   ├─ styles › build-tokens (*)
//   ├─ app
//   │  ├─ dev (*)                                 ← isBackground, иконка "play"
//   │  ├─ build (*)                               ← иконка "package"
//   │  └─ preview (*)
//   ├─ e2e › cypress › run (*)
//   ├─ e2e › cypress › open (*)                   ← isBackground
//   └─ stale-task (*)                             ← hidden
//
// ─ [shared]
//   ├─ proto
//   │  ├─ codegen (*)                             ← task-as-group (hidden=false, дети есть)
//   │  │  ├─ go (*)
//   │  │  ├─ ts (*)
//   │  │  └─ python (*)
//   │  └─ lint (*)
//   ├─ ci › pipeline
//   │  ├─ validate (*)
//   │  ├─ build-all (*)                           ← isDefault
//   │  └─ notify (*)                              ← isBackground
//   └─ docs › generate (*)
//
{
	"scopes": {
		"backend":  "/workspace/backend/.vscode/tasks.json",
		"frontend": "/workspace/frontend/.vscode/tasks.json",
		"shared":   "/workspace/shared/.vscode/tasks.json"
	},

	"tasks": {

		// ── BACKEND ──────────────────────────────────────────────
		"/workspace/backend/.vscode/tasks.json": [
			// build group
			{
				"name": "core:compile",
				"group": { "kind": "build", "isDefault": true },
				"icon": { "id": "package", "color": "terminal.ansiGreen" }
			},
			{
				"name": "core:compile:watch",
				"isBackground": true,
				"group": { "kind": "build", "isDefault": true },
				"icon": { "id": "eye", "color": "terminal.ansiGreen" }
			},

			// test group
			{
				"name": "unit",
				"group": { "kind": "test" },
				"icon": { "id": "beaker", "color": "terminal.ansiYellow" }
			},
			{
				"name": "integration:api",
				"group": { "kind": "test" },
				"icon": { "id": "beaker", "color": "terminal.ansiYellow" }
			},
			{
				"name": "integration:db",
				"group": { "kind": "test" },
				"icon": { "id": "beaker", "color": "terminal.ansiYellow" }
			},
			{
				"name": "e2e:smoke",
				"group": { "kind": "test" },
				"isBackground": true,
				"icon": { "id": "flame", "color": "terminal.ansiRed" }
			},

			// deploy group
			{
				"name": "infra:k8s:deploy-staging",
				"group": { "kind": "deploy" },
				"icon": { "id": "cloud-upload", "color": "terminal.ansiBlue" }
			},
			{
				"name": "infra:k8s:deploy-prod",
				"group": { "kind": "deploy" },
				"hidden": true,
				"icon": { "id": "cloud-upload", "color": "terminal.ansiRed" }
			},

			// ungrouped
			{
				"name": "db:migrate:run",
				"icon": { "id": "database", "color": "terminal.ansiCyan" }
			},
			{
				"name": "db:migrate:rollback",
				"icon": { "id": "database", "color": "terminal.ansiCyan" }
			},
			{
				"name": "db:migrate:seed",
				"icon": { "id": "database", "color": "terminal.ansiMagenta" }
			},
			{ "name": "lint", "icon": { "id": "search" } },
			{
				"name": "all-flags",
				"hidden": true,
				"isBackground": true,
				"group": { "kind": "build", "isDefault": true }
			}
		],

		// ── FRONTEND ─────────────────────────────────────────────
		"/workspace/frontend/.vscode/tasks.json": [
			// ui components — глубокая вложенность, одинаковые leaf-имена
			{ "name": "ui:components:Button:build" },
			{
				"name": "ui:components:Button:test",
				"icon": { "id": "beaker", "color": "terminal.ansiYellow" }
			},
			{
				"name": "ui:components:Button:storybook",
				"isBackground": true,
				"icon": { "id": "book", "color": "terminal.ansiMagenta" }
			},
			{ "name": "ui:components:Modal:build" },
			{ "name": "ui:components:Table:build" },
			{ "name": "ui:components:Table:test" },

			// styles
			{
				"name": "styles:build-tokens",
				"icon": { "id": "paintcan", "color": "terminal.ansiMagenta" }
			},

			// app
			{
				"name": "app:dev",
				"isBackground": true,
				"icon": { "id": "play", "color": "terminal.ansiGreen" }
			},
			{
				"name": "app:build",
				"icon": { "id": "package", "color": "terminal.ansiGreen" }
			},
			{ "name": "app:preview", "icon": { "id": "browser" } },

			// e2e
			{ "name": "e2e:cypress:run" },
			{ "name": "e2e:cypress:open", "isBackground": true },

			// hidden
			{ "name": "stale-task", "hidden": true },

			// blank icon
			{ "name": "secret-experiment", "icon": { "id": "blank" } }
		],

		// ── SHARED ───────────────────────────────────────────────
		"/workspace/shared/.vscode/tasks.json": [
			// proto — task-as-group: "codegen" is both a task and a prefix
			{
				"name": "proto:codegen",
				"icon": { "id": "zap", "color": "terminal.ansiYellow" }
			},
			{ "name": "proto:codegen:go" },
			{ "name": "proto:codegen:ts" },
			{ "name": "proto:codegen:python" },
			{ "name": "proto:lint", "icon": { "id": "search" } },

			// ci pipeline
			{ "name": "ci:pipeline:validate" },
			{
				"name": "ci:pipeline:build-all",
				"group": { "kind": "build", "isDefault": true },
				"icon": { "id": "package", "color": "terminal.ansiGreen" }
			},
			{
				"name": "ci:pipeline:notify",
				"isBackground": true,
				"icon": { "id": "bell", "color": "terminal.ansiBlue" }
			},

			// docs
			{ "name": "docs:generate", "icon": { "id": "notebook" } },

			// hidden task-as-group (дети видимы, задача скрыта)
			{
				"name": "internal:legacy",
				"hidden": true
			},
			{ "name": "internal:legacy:compat-shim" },
			{ "name": "internal:legacy:polyfill" }
		]
	},

	"treeConfig": {
		"segmentSeparator": ":",
		"useGroupKind": true,
		"showHidden": false
	},
	"nodeConfig": {
		"useFolderIcon": false,
		"defaultIconName": "tools",
		"tintLabel": true
	},

	"favorites": {
		"visibility": "AUTO",
		"compressionBehavior": "SMART", // SMART | NORMAL
		"refs": [
			// Cross-scope favorites
			{ "folder": "backend",  "label": "infra:k8s:deploy-prod" },     // hidden task
			{ "folder": "backend",  "label": "db:migrate:run" },            // regular deep
			{ "folder": "frontend", "label": "ui:components:Button:test" }, // deep cross-scope
			{ "folder": "shared",   "label": "proto:codegen" },             // task-as-group

			// Duplicate scope name collision test:
			// "lint" exists in both backend and shared, but fav points to backend
			{ "folder": "backend", "label": "lint" },

			// Favorite on a task whose parent group is hidden
			{ "folder": "shared", "label": "internal:legacy:compat-shim" }
		],
		"stales": [
			// Dead ref — folder doesn't exist in scopes
			{ "folder": "DEAD_FOLDER", "label": "ghost:task" }
		]
	}
}