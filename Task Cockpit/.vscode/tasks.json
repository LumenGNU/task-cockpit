      "problemMatcher": [
        {
          "owner": "strip-debug-blocks.bash",
          "fileLocation": "relative",
          "pattern": [
            {
              "regexp": "^(.+):(\\d+): (.*)$",
              "kind": "line",
              "file": 1,
              "line": 2,
              "message": 3
            }
          ]
