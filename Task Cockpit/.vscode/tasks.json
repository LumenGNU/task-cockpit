    {
      "label": "Build|Build All (Dev Mode)",
      "detail": "Transpile TypeScript to `./~out`",
      "icon": {
        "id": "rocket"
      },
      "dependsOn": [
        "Dev Environment|Prepare|Create/Clean '~out/'"
