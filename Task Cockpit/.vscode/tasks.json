        "Dev Environment|Prepare|Create/Clean '~vsix/'",
        "Dev Environment|Prepare|Install project dependencies"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "echo -e '\\e[32;1m[DONE] Environment ready\\e[0m\\n'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "panel": "shared",
        "clear": false,
        "echo": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
