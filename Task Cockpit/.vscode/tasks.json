      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "SOURCE_DIR": "src",
          "FIND_FILTERS": "-wholename 'src/*.ts' ! -path 'src/test/*' ! -path 'src/Logger.ts'",
