{
    "version": "2.0.0",
    "tasks": [
        // ---------------------------------------------------------
        // задачи без зависимостей
        {
            "label": "existing task",
            "command": "echo hello",
            "type": "shell",
            "args": [],
            "problemMatcher": []
        },
        // ---------------------------------------------------------
        {
            "label": "depends on «empty label»",
            "problemMatcher": [],
            "dependsOn": "" // Err "«empty label»" was not found
        },
        {
            "label": "depends on empty depends list",
            "problemMatcher": [],
            "dependsOn": [] // Ok, но VS Code не построит эту задачу
        },
        {
            "label": "depends on empty object",
            "problemMatcher": [],
            "dependsOn": {} // Ok, но VS Code не построит эту задачу
        },

        // Дубликаты, но одна задача имеет сломанную зависимость
        {
            "label": "dup with depends", // Дубликат
            "problemMatcher": [],
            "dependsOn": [
                "non existing task" // Err
            ]
        },
        {
            "label": "dup with depends", // Дубликат
            "problemMatcher": [],
            "dependsOn": [
                "existing task" // Ok
            ]
        },

        // dependsOn на дубликат
        {
            "label": "task",
            "problemMatcher": [],
            "dependsOn": [
                "dup with depends" // Ok
            ]
        }
    ]
