{
    "version": "2.0.0",
    "tasks": [
        // ---------------------------------------------------------
        // задачи без зависимостей
        {
            "label": "folder1 level task",
            "type": "shell",
            "command": "echo 'folder1 level task'",
            "problemMatcher": []
        },
        {
            "label": "existing task",
            "type": "shell",
            "command": "echo 'existing task from folder1'",
            "problemMatcher": []
        },
        // ---------------------------------------------------------
        {
            "label": "(folder1) depends on 'existing task'",
            "dependsOn": "existing task", // существует и доступна
            "problemMatcher": []
        },
        {
            "label": "(folder1) depends on 'folder2 level task'",
            "dependsOn": "folder2 level task",
            // существует в folder2/.vscode/tasks.json
            // НО из folder1 scope НЕ доступна
            "problemMatcher": []
        },
        {
            "label": "(folder1) depends on 'workspace level task'",
            // существует в .code-workspace
            // доступна ТОЛЬКО если folder1 первая в проекте
            "dependsOn": "workspace level task",
            "problemMatcher": []
        },
        {
            "label": "(folder1) depends on 'user level task'",
            // существует в .../User/tasks.json
            // доступна ТОЛЬКО если folder1 первая в проекте
            "dependsOn": "user level task",
            "problemMatcher": []
        }
    ]
}
