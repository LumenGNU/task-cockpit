{
  "name": "task-cockpit",
  "publisher": "papio-dev",
  "displayName": "Task Cockpit test extension",
  "description": "Task Cockpit test extension",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "extension.js",
  "contributes": {
    "commands": [],
    "configuration": {
      "title": "File Decoration",
      "properties": {
        "taskCockpit.display.badges.runningSymbol": {
          "type": "string",
          "default": "●",
          "pattern": "^[^\\d\\s]$",
          "markdownDescription": "..."
        },
        "taskCockpit.display.badges.overflowSymbol": {
          "type": "string",
          "default": "+",
          "pattern": "^[^\\d\\s]$",
          "markdownDescription": "..."
        },
        "taskCockpit.display.badges.badgeOrder": {
          "type": "string",
          "default": "symbolFirst",
          "enum": [
            "symbolFirst",
            "countFirst"
          ],
          "enumDescriptions": [
            "Symbol first",
            "Count first"
          ]
        },
        "taskCockpit.display.badges.availableSymbol": {
          "type": "string",
          "default": "•",
          "pattern": "^[^\\d\\s]$",
          "markdownDescription": "..."
        }
      }
    }
  }
}
