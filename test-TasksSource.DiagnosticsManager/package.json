{
  "name": "task-cockpit",
  "publisher": "papio-dev",
  "displayName": "Task Cockpit test extension",
  "description": "Task Cockpit test extension",
  "version": "0.0.0",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "extension.js",
  "contributes": {
    "commands": [
      {
        "command": "debug.A",
        "icon": "$(debug)",
        "title": "DEBUG A"
      }
    ]
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.86.0",
    "mocha": "^11.3.0",
    "typescript": "^5.9.3",
    "tsc-alias": "^1.8.17"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
