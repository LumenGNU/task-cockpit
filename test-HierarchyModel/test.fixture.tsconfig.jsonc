{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "sourceMap": true,
        "removeComments": false,
        "outDir": "./~out-test",
        "paths": {
            "src/*": ["./~stripped/*"]
        }
    },
    "exclude": [
        "./test/**/~*",
        "./test/~*",
        "./test-*/**/~*",
        "./test-*/~*",
        "./~stripped/**/~*",
        "./~stripped/~*"
    ],
    "include": [
        "./test/fixture/*.ts",
        "./test/fixture/**/*.ts",
        "./test-*/fixture/*.ts",
        "./test-*/fixture/**/*.ts",
        "./~stripped/extension.ts"
        // "./~stripped/**/*.ts"
    ]
}
