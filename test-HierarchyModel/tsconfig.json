{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "incremental": false,
        "sourceMap": false,
        "removeComments": false,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "types": [
            "node",
            "mocha"
        ],
        "rootDir": ".",
        "paths": {
            "src/*": [
                "./src/*"
            ]
        }
    },
    "exclude": [
        "**/~*"
    ],
}
